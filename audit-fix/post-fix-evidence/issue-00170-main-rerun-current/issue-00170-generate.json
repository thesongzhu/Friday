        "files": [
          {
            "path": "run.sh",
            "content": "#!/usr/bin/env bash\n\nset -euo pipefail\n\n# Read input JSON from stdin\nINPUT_JSON=\"$(cat)\"\n\ndirectoryPath=$(echo \"$INPUT_JSON\" | jq -r '.directoryPath')\n\nif [[ ! -d \"$directoryPath\" ]]; then\n  echo '{\"error\": \"Invalid directory path.\"}'\n  exit 1\nfi\n\n# Find the top 3 largest files in the directory\nlargestFiles=$(find \"$directoryPath\" -type f -exec du -b {} + | sort -nr | head -n 3 | awk '{print {\"size\": $1, \"path\": $2}}' | jq -s '.')\n\n# Output the result as JSON\njq -n --argjson largestFiles \"$largestFiles\" '{largestFiles: $largestFiles}'\n",
