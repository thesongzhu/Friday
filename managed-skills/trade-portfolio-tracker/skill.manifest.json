{
  "schemaVersion": "2.0",
  "id": "trade-portfolio-tracker",
  "name": "持仓跟踪器",
  "description": "Tracks user's actual holdings, entry prices, current P&L, and position sizing.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": {
    "name": "friday-trade"
  },
  "tags": ["trade", "portfolio", "持仓", "P&L"],
  "runtime": {
    "kind": "shell",
    "entrypoint": "run.sh",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 30000
  },
  "triggers": {
    "intents": [],
    "phrases": ["持仓", "portfolio", "我的仓位", "holdings"],
    "channels": ["*"]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 50,
    "modes": ["intent"]
  },
  "requirements": {
    "bins": ["node"],
    "env": [],
    "config": [],
    "os": ["darwin", "linux", "win32"]
  },
  "inputs": [
    {
      "key": "action",
      "type": "string",
      "description": "Action to perform on the portfolio",
      "required": true,
      "enum": ["view", "add_position", "close_position", "update_price"]
    },
    {
      "key": "symbol",
      "type": "string",
      "description": "Stock code (e.g. 000001, 600519)",
      "required": false
    },
    {
      "key": "shares",
      "type": "number",
      "description": "Number of shares to buy or sell",
      "required": false
    },
    {
      "key": "price",
      "type": "number",
      "description": "Entry price (add_position), exit price (close_position), or current price (update_price)",
      "required": false
    },
    {
      "key": "side",
      "type": "string",
      "description": "Trade direction",
      "required": false,
      "enum": ["buy", "sell"]
    },
    {
      "key": "date",
      "type": "string",
      "description": "Trade date in YYYY-MM-DD format",
      "required": false
    },
    {
      "key": "notes",
      "type": "string",
      "description": "Optional notes for the trade",
      "required": false
    }
  ],
  "outputs": [
    {
      "key": "portfolio",
      "type": "object",
      "description": "Current holdings with P&L summary"
    },
    {
      "key": "cashAvailable",
      "type": "number",
      "description": "Available cash balance"
    },
    {
      "key": "exposurePct",
      "type": "number",
      "description": "Total portfolio exposure as percentage"
    },
    {
      "key": "positionBreakdown",
      "type": "array",
      "description": "Per-position details with unrealized P&L"
    },
    {
      "key": "tradeHistory",
      "type": "array",
      "description": "Recent trade history with realized P&L"
    },
    {
      "key": "stdout",
      "type": "string",
      "description": "Command standard output"
    },
    {
      "key": "stderr",
      "type": "string",
      "description": "Command standard error"
    },
    {
      "key": "exitCode",
      "type": "number",
      "description": "Command exit code"
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "shell.execute",
        "resource": "shell",
        "action": "execute",
        "required": true,
        "reason": "Executes portfolio tracking logic via run.sh"
      }
    ],
    "promptOn": ["shell.execute"]
  },
  "schemas": {
    "input": null,
    "state": null,
    "output": null
  },
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": ["phone", "desktop", "rpi", "cloud-vm"],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": []
  }
}
