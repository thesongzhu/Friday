{
  "schemaVersion": "1.0",
  "title": "Portfolio Tracker",
  "description": "Track positions, P&L, and trade history",
  "sections": [
    {
      "id": "action",
      "label": "Action",
      "fieldIds": [
        "action"
      ]
    },
    {
      "id": "trade",
      "label": "Trade Details",
      "fieldIds": [
        "symbol",
        "shares",
        "price",
        "side",
        "date",
        "notes"
      ]
    }
  ],
  "fields": [
    {
      "id": "action",
      "inputKey": "action",
      "label": "Action",
      "widget": "select",
      "options": [
        {
          "value": "view",
          "label": "View Portfolio (View Portfolio)"
        },
        {
          "value": "add_position",
          "label": "Add Position (Add Position)"
        },
        {
          "value": "close_position",
          "label": "Close Position (Close Position)"
        },
        {
          "value": "update_price",
          "label": "Update Price (Update Price)"
        }
      ],
      "default": "view"
    },
    {
      "id": "symbol",
      "inputKey": "symbol",
      "label": "Stock Code",
      "widget": "text",
      "placeholder": "e.g. 000001, 600519"
    },
    {
      "id": "shares",
      "inputKey": "shares",
      "label": "Shares",
      "widget": "number",
      "placeholder": "Number of shares"
    },
    {
      "id": "price",
      "inputKey": "price",
      "label": "Price",
      "widget": "number",
      "placeholder": "Entry/exit/current price"
    },
    {
      "id": "side",
      "inputKey": "side",
      "label": "Side",
      "widget": "select",
      "options": [
        {
          "value": "buy",
          "label": "Buy (Buy)"
        },
        {
          "value": "sell",
          "label": "Sell (Sell)"
        }
      ]
    },
    {
      "id": "date",
      "inputKey": "date",
      "label": "Trade Date",
      "widget": "text",
      "placeholder": "YYYY-MM-DD"
    },
    {
      "id": "notes",
      "inputKey": "notes",
      "label": "Notes",
      "widget": "text",
      "placeholder": "Optional trade notes"
    }
  ],
  "outputs": [
    {
      "id": "output-portfolio",
      "outputKey": "portfolio",
      "label": "Portfolio Summary",
      "widget": "json"
    },
    {
      "id": "output-cashAvailable",
      "outputKey": "cashAvailable",
      "label": "Cash Available",
      "widget": "text"
    },
    {
      "id": "output-exposurePct",
      "outputKey": "exposurePct",
      "label": "Exposure %",
      "widget": "text"
    },
    {
      "id": "output-positionBreakdown",
      "outputKey": "positionBreakdown",
      "label": "Position Breakdown",
      "widget": "table"
    },
    {
      "id": "output-tradeHistory",
      "outputKey": "tradeHistory",
      "label": "Trade History",
      "widget": "table"
    },
    {
      "id": "output-stdout",
      "outputKey": "stdout",
      "label": "Command standard output",
      "widget": "text"
    },
    {
      "id": "output-stderr",
      "outputKey": "stderr",
      "label": "Command standard error",
      "widget": "text"
    },
    {
      "id": "output-exitCode",
      "outputKey": "exitCode",
      "label": "Command exit code",
      "widget": "text"
    }
  ],
  "actions": [
    {
      "id": "run",
      "label": "Execute",
      "style": "primary"
    },
    {
      "id": "reset",
      "label": "Reset",
      "style": "secondary"
    }
  ]
}