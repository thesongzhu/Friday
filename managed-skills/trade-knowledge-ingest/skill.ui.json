{
  "schemaVersion": "1.0",
  "title": "Knowledge Ingest Engine",
  "description": "Import trading knowledge into Friday memory system",
  "sections": [
    {
      "id": "main",
      "label": "Import Configuration",
      "fieldIds": [
        "contentDir",
        "namespace",
        "forceReindex",
        "aiExportDir"
      ]
    }
  ],
  "fields": [
    {
      "id": "contentDir",
      "inputKey": "contentDir",
      "label": "Knowledge Base Directory",
      "widget": "text",
      "help": "Root directory path of the trading knowledge base"
    },
    {
      "id": "namespace",
      "inputKey": "namespace",
      "label": "Namespace",
      "widget": "text",
      "help": "Memory storage namespace prefix"
    },
    {
      "id": "forceReindex",
      "inputKey": "forceReindex",
      "label": "Force Reindex",
      "widget": "checkbox"
    },
    {
      "id": "aiExportDir",
      "inputKey": "aiExportDir",
      "label": "AI Export Directory",
      "widget": "text",
      "help": "Optional: specify ai_export directory directly"
    }
  ],
  "outputs": [
    {
      "id": "output-chunksIngested",
      "outputKey": "chunksIngested",
      "label": "Chunks Ingested",
      "widget": "text"
    },
    {
      "id": "output-categoryCounts",
      "outputKey": "categoryCounts",
      "label": "Category Counts",
      "widget": "json"
    },
    {
      "id": "output-errors",
      "outputKey": "errors",
      "label": "Errors",
      "widget": "text"
    }
  ],
  "actions": [
    {
      "id": "run",
      "label": "Start Import",
      "style": "primary"
    },
    {
      "id": "reset",
      "label": "Reset",
      "style": "secondary"
    }
  ]
}