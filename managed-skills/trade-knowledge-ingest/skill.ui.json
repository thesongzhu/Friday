{
  "schemaVersion": "1.0",
  "title": "交易知识导入引擎",
  "description": "将交易知识库导入 Friday 记忆系统",
  "sections": [
    {
      "id": "main",
      "label": "导入配置",
      "fieldIds": ["contentDir", "namespace", "forceReindex", "aiExportDir"]
    }
  ],
  "fields": [
    {
      "id": "contentDir",
      "inputKey": "contentDir",
      "label": "知识库目录",
      "widget": "text",
      "help": "Trade Agent OG 根目录路径"
    },
    {
      "id": "namespace",
      "inputKey": "namespace",
      "label": "命名空间",
      "widget": "text",
      "help": "记忆存储命名空间前缀"
    },
    {
      "id": "forceReindex",
      "inputKey": "forceReindex",
      "label": "强制重新索引",
      "widget": "checkbox"
    },
    {
      "id": "aiExportDir",
      "inputKey": "aiExportDir",
      "label": "AI导出目录",
      "widget": "text",
      "help": "可选：直接指定 ai_export 目录"
    }
  ],
  "outputs": [
    {
      "id": "output-chunksIngested",
      "outputKey": "chunksIngested",
      "label": "导入块数",
      "widget": "text"
    },
    {
      "id": "output-categoryCounts",
      "outputKey": "categoryCounts",
      "label": "分类统计",
      "widget": "json"
    },
    {
      "id": "output-errors",
      "outputKey": "errors",
      "label": "错误列表",
      "widget": "text"
    }
  ],
  "actions": [
    { "id": "run", "label": "开始导入", "style": "primary" },
    { "id": "reset", "label": "重置", "style": "secondary" }
  ]
}
