{
  "schemaVersion": "1.0",
  "title": "Board Strategy Analyzer",
  "description": "Analyze limit-up board trading opportunities",
  "sections": [
    {
      "id": "params",
      "label": "Strategy Parameters",
      "fieldIds": [
        "strategyType",
        "sentimentPhase"
      ]
    },
    {
      "id": "data",
      "label": "Market Data",
      "fieldIds": [
        "marketData"
      ]
    }
  ],
  "fields": [
    {
      "id": "strategyType",
      "inputKey": "strategyType",
      "label": "Strategy Type",
      "widget": "select",
      "options": [
        {
          "value": "all",
          "label": "All Strategies (All)"
        },
        {
          "value": "first_board",
          "label": "First Board (First Board)"
        },
        {
          "value": "second_board",
          "label": "1-to-2 Board (Second Board)"
        },
        {
          "value": "weak_to_strong",
          "label": "Weak-to-Strong (Weak to Strong)"
        },
        {
          "value": "reversal_wrap",
          "label": "Reversal Wrap (Reversal Wrap)"
        }
      ],
      "default": "all"
    },
    {
      "id": "sentimentPhase",
      "inputKey": "sentimentPhase",
      "label": "Sentiment Phase",
      "widget": "select",
      "options": [
        {
          "value": "",
          "label": "Auto-detect"
        },
        {
          "value": "initiation",
          "label": "Startup Phase (Initiation)"
        },
        {
          "value": "expansion",
          "label": "Expansion Phase (Expansion)"
        },
        {
          "value": "divergence",
          "label": "Divergence Phase (Divergence)"
        },
        {
          "value": "decline",
          "label": "EbbPhase (Decline)"
        },
        {
          "value": "ice",
          "label": "Ice PointPhase (Ice)"
        }
      ]
    },
    {
      "id": "marketData",
      "inputKey": "marketData",
      "label": "Market Data (JSON)",
      "widget": "textarea",
      "placeholder": "Paste market data JSON here"
    }
  ],
  "outputs": [
    {
      "id": "output-setups",
      "outputKey": "setups",
      "label": "Trade Setups",
      "widget": "table"
    },
    {
      "id": "output-ranking",
      "outputKey": "ranking",
      "label": "Ranked Setups",
      "widget": "table"
    },
    {
      "id": "output-warnings",
      "outputKey": "warnings",
      "label": "Risk Warnings",
      "widget": "table"
    },
    {
      "id": "output-stdout",
      "outputKey": "stdout",
      "label": "Command standard output",
      "widget": "text"
    },
    {
      "id": "output-stderr",
      "outputKey": "stderr",
      "label": "Command standard error",
      "widget": "text"
    },
    {
      "id": "output-exitCode",
      "outputKey": "exitCode",
      "label": "Command exit code",
      "widget": "text"
    }
  ],
  "actions": [
    {
      "id": "run",
      "label": "Analyze",
      "style": "primary"
    },
    {
      "id": "reset",
      "label": "Reset",
      "style": "secondary"
    }
  ]
}