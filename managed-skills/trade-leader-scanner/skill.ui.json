{
  "schemaVersion": "1.0",
  "title": "Leader Stock Scanner",
  "description": "Identify and rank market leader stocks",
  "sections": [
    {
      "id": "params",
      "label": "Scan Parameters",
      "fieldIds": [
        "scope",
        "sector",
        "sentimentPhase"
      ]
    },
    {
      "id": "data",
      "label": "Market Data",
      "fieldIds": [
        "marketData"
      ]
    }
  ],
  "fields": [
    {
      "id": "scope",
      "inputKey": "scope",
      "label": "Scan Scope",
      "widget": "select",
      "options": [
        {
          "value": "market_wide",
          "label": "Market Wide (Full Market)"
        },
        {
          "value": "sector",
          "label": "Sector (Sector)"
        },
        {
          "value": "watchlist",
          "label": "Watchlist (Watchlist)"
        }
      ],
      "default": "market_wide"
    },
    {
      "id": "sector",
      "inputKey": "sector",
      "label": "Sector Filter",
      "widget": "text",
      "placeholder": "e.g. AI, Robotics, Semiconductor"
    },
    {
      "id": "sentimentPhase",
      "inputKey": "sentimentPhase",
      "label": "Sentiment Phase",
      "widget": "select",
      "options": [
        {
          "value": "",
          "label": "Auto-detect"
        },
        {
          "value": "initiation",
          "label": "Startup Phase (Initiation)"
        },
        {
          "value": "expansion",
          "label": "Expansion Phase (Expansion)"
        },
        {
          "value": "divergence",
          "label": "Divergence Phase (Divergence)"
        },
        {
          "value": "decline",
          "label": "EbbPhase (Decline)"
        },
        {
          "value": "ice",
          "label": "Ice PointPhase (Ice)"
        }
      ]
    },
    {
      "id": "marketData",
      "inputKey": "marketData",
      "label": "Market Data (JSON)",
      "widget": "textarea",
      "placeholder": "Paste limit-up pool JSON data here"
    }
  ],
  "outputs": [
    {
      "id": "output-leaders",
      "outputKey": "leaders",
      "label": "Ranked Leader Candidates",
      "widget": "table"
    },
    {
      "id": "output-leaderHistory",
      "outputKey": "leaderHistory",
      "label": "Leader Evolution History",
      "widget": "table"
    },
    {
      "id": "output-rotationSignal",
      "outputKey": "rotationSignal",
      "label": "Rotation Signal",
      "widget": "text"
    },
    {
      "id": "output-stdout",
      "outputKey": "stdout",
      "label": "Command standard output",
      "widget": "text"
    },
    {
      "id": "output-stderr",
      "outputKey": "stderr",
      "label": "Command standard error",
      "widget": "text"
    },
    {
      "id": "output-exitCode",
      "outputKey": "exitCode",
      "label": "Command exit code",
      "widget": "text"
    }
  ],
  "actions": [
    {
      "id": "run",
      "label": "Scan Leaders",
      "style": "primary"
    },
    {
      "id": "reset",
      "label": "Reset",
      "style": "secondary"
    }
  ]
}