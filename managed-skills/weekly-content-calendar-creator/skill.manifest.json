{
  "schemaVersion": "2.0",
  "id": "weekly-content-calendar-creator",
  "name": "Weekly Content Calendar Creator",
  "description": "Create a weekly content calendar for Chinese content creators from topic ideas, comment screenshots, or notes.",
  "version": "1.0.0",
  "kind": "workflow",
  "category": "automation",
  "author": {
    "name": "Content Solutions Inc."
  },
  "tags": [
    "generated",
    "skill.stabilized"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 30000
  },
  "triggers": {
    "intents": [],
    "phrases": [],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 50,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux",
      "win32"
    ],
    "mcpServers": []
  },
  "inputs": [
    {
      "key": "topicIdeas",
      "type": "string",
      "required": true,
      "label": "Topic Ideas"
    },
    {
      "key": "commentScreenshots",
      "type": "file",
      "required": false,
      "label": "Comment Screenshots"
    },
    {
      "key": "notes",
      "type": "string",
      "required": false,
      "label": "Notes"
    }
  ],
  "outputs": [
    {
      "key": "contentCalendar",
      "type": "string",
      "description": "Weekly content calendar with hooks, formats, and repurposing suggestions."
    }
  ],
  "permissions": {
    "grants": [],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": []
  }
}