{
  "schemaVersion": "1.0",
  "title": "Weekly Content Calendar Creator",
  "description": "Create a weekly content calendar for Chinese content creators from topic ideas, comment screenshots, or notes.",
  "sections": [
    {
      "id": "main",
      "label": "Inputs",
      "fieldIds": [
        "topicIdeas-field",
        "commentScreenshots-field",
        "notes-field"
      ]
    }
  ],
  "fields": [
    {
      "id": "topicIdeas-field",
      "inputKey": "topicIdeas",
      "kind": "text",
      "label": "Topic Ideas",
      "required": true
    },
    {
      "id": "commentScreenshots-field",
      "inputKey": "commentScreenshots",
      "kind": "file",
      "label": "Comment Screenshots",
      "required": false
    },
    {
      "id": "notes-field",
      "inputKey": "notes",
      "kind": "text",
      "label": "Notes",
      "required": false
    }
  ],
  "outputs": [
    {
      "id": "contentCalendar-output",
      "outputKey": "contentCalendar",
      "label": "contentCalendar",
      "widget": "text"
    }
  ],
  "actions": [
    {
      "id": "run",
      "label": "Run",
      "style": "primary"
    },
    {
      "id": "reset",
      "label": "Reset",
      "style": "secondary"
    }
  ]
}