{
  "schemaVersion": "1.0",
  "title": "Strategy Fitness Analyzer",
  "description": "Analyze strategy fit and recommend improvements",
  "sections": [
    {
      "id": "config",
      "label": "Analysis Settings",
      "fieldIds": [
        "period"
      ]
    }
  ],
  "fields": [
    {
      "id": "period",
      "inputKey": "period",
      "label": "Analysis Period",
      "widget": "select",
      "options": [
        {
          "label": "This Month",
          "value": "month"
        },
        {
          "label": "This Quarter",
          "value": "quarter"
        },
        {
          "label": "All",
          "value": "all"
        }
      ]
    }
  ],
  "outputs": [
    {
      "id": "output-strategyScores",
      "outputKey": "strategyScores",
      "label": "Strategy Scores",
      "widget": "text"
    },
    {
      "id": "output-recommendations",
      "outputKey": "recommendations",
      "label": "Recommendations",
      "widget": "text"
    },
    {
      "id": "output-profileUpdateSuggestions",
      "outputKey": "profileUpdateSuggestions",
      "label": "User ProfileUpdateSuggestions",
      "widget": "text"
    },
    {
      "id": "output-knowledgeGaps",
      "outputKey": "knowledgeGaps",
      "label": "Knowledge Gaps",
      "widget": "text"
    }
  ],
  "actions": [
    {
      "id": "run",
      "label": "Analyze",
      "style": "primary"
    },
    {
      "id": "reset",
      "label": "Reset",
      "style": "secondary"
    }
  ]
}