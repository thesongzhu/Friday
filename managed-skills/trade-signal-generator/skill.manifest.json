{
  "schemaVersion": "2.0",
  "id": "trade-signal-generator",
  "name": "Trade Signal Generator",
  "description": "Synthesizes outputs from all analysis skills into concrete entry/exit signals with confidence scores, position sizing, and knowledge base references.",
  "version": "1.0.0",
  "kind": "system",
  "category": "ai",
  "author": {
    "name": "friday-trade"
  },
  "tags": [
    "trade",
    "signal",
    "Signals",
    "entry",
    "exit"
  ],
  "runtime": {
    "kind": "shell",
    "entrypoint": "run.sh",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 30000
  },
  "triggers": {
    "intents": [],
    "phrases": [
      "交易信号",
      "trade signals",
      "买什么",
      "what to buy",
      "generate signals",
      "what to trade"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 50,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [
      "node"
    ],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "inputs": [
    {
      "key": "mode",
      "type": "string",
      "description": "Scan mode: full_scan, watchlist_only, or specific_stock",
      "required": false,
      "default": "full_scan",
      "enum": [
        "full_scan",
        "watchlist_only",
        "specific_stock"
      ]
    },
    {
      "key": "symbol",
      "type": "string",
      "description": "Stock code for specific_stock mode",
      "required": false
    },
    {
      "key": "sentimentPhase",
      "type": "string",
      "description": "Current sentiment cycle phase (e.g. initiation, expansion, divergence, decline, ice)",
      "required": false
    },
    {
      "key": "leaders",
      "type": "array",
      "description": "Leader stocks from leader scanner skill",
      "required": false
    },
    {
      "key": "boardSetups",
      "type": "array",
      "description": "Board strategy setups from board strategy skill",
      "required": false
    },
    {
      "key": "dipBuyCandidates",
      "type": "array",
      "description": "Dip buy candidates from dip buy scanner skill",
      "required": false
    },
    {
      "key": "auctionSignals",
      "type": "array",
      "description": "Auction analysis signals from auction analyzer skill",
      "required": false
    },
    {
      "key": "portfolio",
      "type": "object",
      "description": "Current portfolio holdings for deduplication",
      "required": false
    },
    {
      "key": "userProfile",
      "type": "object",
      "description": "User preferences: capitalSize, maxPositionPct, preferredStyles, riskTolerance",
      "required": false
    }
  ],
  "outputs": [
    {
      "key": "signals",
      "type": "array",
      "description": "Ranked trade signals with entry/exit levels, sizing, and confidence"
    },
    {
      "key": "marketContext",
      "type": "object",
      "description": "Overall market context: sentiment phase, sector rotation info"
    },
    {
      "key": "riskWarnings",
      "type": "array",
      "description": "Risk warnings and cautionary notes"
    },
    {
      "key": "stdout",
      "type": "string",
      "description": "Command standard output"
    },
    {
      "key": "stderr",
      "type": "string",
      "description": "Command standard error"
    },
    {
      "key": "exitCode",
      "type": "number",
      "description": "Command exit code"
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "shell.execute",
        "resource": "shell",
        "action": "execute",
        "required": true,
        "reason": "Executes signal generation logic via run.sh"
      }
    ],
    "promptOn": [
      "shell.execute"
    ]
  },
  "schemas": {
    "input": null,
    "state": null,
    "output": null
  },
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "phone",
      "desktop",
      "rpi",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": []
  }
}