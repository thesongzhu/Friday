{
  "schemaVersion": "2.0",
  "id": "trade-master-agent",
  "name": "Trade Master Agent",
  "description": "Conversational trading assistant that routes natural language queries to the appropriate trading skills and orchestrates multi-skill workflows.",
  "version": "1.0.0",
  "kind": "conversation",
  "category": "ai",
  "author": {
    "name": "friday-trade"
  },
  "tags": [
    "trade",
    "agent",
    "nlp",
    "a-stock"
  ],
  "runtime": {
    "kind": "shell",
    "entrypoint": "run.sh",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 60000
  },
  "triggers": {
    "intents": [
      "trade_assistant"
    ],
    "phrases": [
      "交易助手",
      "trade agent",
      "帮我分析",
      "帮我看看",
      "今天买什么",
      "trade assistant",
      "trading help",
      "analyze for me"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 100,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [
      "node"
    ],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "inputs": [
    {
      "key": "query",
      "type": "string",
      "description": "User's question or command",
      "required": true
    },
    {
      "key": "context",
      "type": "object",
      "description": "Additional context",
      "required": false
    }
  ],
  "outputs": [
    {
      "key": "response",
      "type": "string",
      "description": "Agent Response"
    },
    {
      "key": "skillsUsed",
      "type": "array",
      "description": "Skills invoked"
    },
    {
      "key": "data",
      "type": "object",
      "description": "Structured data"
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "shell.execute",
        "resource": "shell",
        "action": "execute",
        "required": true,
        "reason": "Executes agent orchestration script via run.sh"
      }
    ],
    "promptOn": [
      "shell.execute"
    ]
  },
  "schemas": {
    "input": null,
    "state": null,
    "output": null
  },
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "phone",
      "desktop",
      "rpi",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": []
  }
}