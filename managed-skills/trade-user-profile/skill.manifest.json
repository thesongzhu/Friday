{
  "schemaVersion": "2.0",
  "id": "trade-user-profile",
  "name": "User Trading Profile",
  "description": "Stores and manages each user's trading configuration: capital, risk tolerance, preferred strategies, watchlists, sectors, and notification preferences.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": {
    "name": "friday-trade"
  },
  "tags": [
    "trading",
    "profile",
    "configuration"
  ],
  "runtime": {
    "kind": "shell",
    "entrypoint": "run.sh",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 30000
  },
  "triggers": {
    "intents": [],
    "phrases": [
      "trading profile",
      "my settings",
      "update profile"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 50,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [
      "node"
    ],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "inputs": [
    {
      "key": "action",
      "type": "string",
      "description": "Action Type: get(Get), set(Set), update(Update), reset(Reset)",
      "required": true,
      "enum": [
        "get",
        "set",
        "update",
        "reset"
      ]
    },
    {
      "key": "field",
      "type": "string",
      "description": "Specific field name to operate on",
      "required": false
    },
    {
      "key": "value",
      "type": "object",
      "description": "ToSetorUpdatenew value",
      "required": false
    }
  ],
  "outputs": [
    {
      "key": "profile",
      "type": "object",
      "description": "Full or partial user profileData"
    },
    {
      "key": "changesMade",
      "type": "array",
      "description": "List of changes made"
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "shell.execute",
        "resource": "shell",
        "action": "execute",
        "required": true,
        "reason": "Executes profile CRUD operations via run.sh"
      }
    ],
    "promptOn": [
      "shell.execute"
    ]
  },
  "schemas": {
    "input": null,
    "state": null,
    "output": null
  },
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "phone",
      "desktop",
      "rpi",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": []
  }
}