{
  "schemaVersion": "2.0",
  "id": "trade-market-realtime",
  "name": "Market Realtime Data",
  "description": "Fetches real-time A-stock market data via AKShare: quotes, limit-up pool, sector heat, indices, auction data, and dragon-tiger list.",
  "version": "1.0.0",
  "kind": "system",
  "category": "integration",
  "author": {
    "name": "friday-trade"
  },
  "tags": [
    "trade",
    "akshare",
    "realtime",
    "a-stock"
  ],
  "runtime": {
    "kind": "shell",
    "entrypoint": "run.sh",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 30000
  },
  "triggers": {
    "intents": [],
    "phrases": [
      "获取实时行情",
      "show live market",
      "涨停池",
      "live market",
      "real-time quotes",
      "market data"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 50,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [
      "python3"
    ],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "inputs": [
    {
      "key": "dataType",
      "type": "string",
      "description": "Data Type：quote=Stock Quotes, limit_up_pool=Limit-Up Pool, sector_heat=Sector Heat, index=Index Data, auction=Auction Data, dragon_tiger=Dragon-Tiger List",
      "required": true,
      "enum": [
        "quote",
        "limit_up_pool",
        "sector_heat",
        "index",
        "auction",
        "dragon_tiger"
      ]
    },
    {
      "key": "symbols",
      "type": "array",
      "description": "Stock CodeList，e.g. [\"000001\", \"600519\"]，Only quote and auction types use",
      "required": false
    },
    {
      "key": "sector",
      "type": "string",
      "description": "SectorName，for sector_heat filtering",
      "required": false
    }
  ],
  "outputs": [
    {
      "key": "data",
      "type": "object",
      "description": "QuoteData"
    },
    {
      "key": "fetchedAt",
      "type": "string",
      "description": "DataGetTime"
    },
    {
      "key": "source",
      "type": "string",
      "description": "DataSource"
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "shell.execute",
        "resource": "shell",
        "action": "execute",
        "required": true,
        "reason": "Executes Python script via run.sh to fetch market data"
      }
    ],
    "promptOn": [
      "shell.execute"
    ]
  },
  "schemas": {
    "input": null,
    "state": null,
    "output": null
  },
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "phone",
      "desktop",
      "rpi",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": []
  }
}