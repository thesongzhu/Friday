{
  "schemaVersion": "1.0",
  "title": "Market Realtime Data",
  "description": "Fetch real-time market quotes and data",
  "sections": [
    {
      "id": "main",
      "label": "Parameters",
      "fieldIds": [
        "dataType",
        "symbols",
        "sector"
      ]
    }
  ],
  "fields": [
    {
      "id": "dataType",
      "inputKey": "dataType",
      "label": "Data Type",
      "widget": "select",
      "options": [
        {
          "value": "quote",
          "label": "Stock Quotes"
        },
        {
          "value": "limit_up_pool",
          "label": "Limit-Up Pool"
        },
        {
          "value": "sector_heat",
          "label": "Sector Heat"
        },
        {
          "value": "index",
          "label": "Index Data"
        },
        {
          "value": "auction",
          "label": "Auction Data"
        },
        {
          "value": "dragon_tiger",
          "label": "Dragon-Tiger List"
        }
      ],
      "required": true
    },
    {
      "id": "symbols",
      "inputKey": "symbols",
      "label": "Stock CodeList",
      "widget": "text",
      "placeholder": "e.g.: 000001,600519",
      "required": false
    },
    {
      "id": "sector",
      "inputKey": "sector",
      "label": "SectorName",
      "widget": "text",
      "placeholder": "e.g.: Semiconductor",
      "required": false
    }
  ],
  "outputs": [
    {
      "id": "output-data",
      "outputKey": "data",
      "label": "QuoteData",
      "widget": "json"
    },
    {
      "id": "output-fetchedAt",
      "outputKey": "fetchedAt",
      "label": "GetTime",
      "widget": "text"
    },
    {
      "id": "output-source",
      "outputKey": "source",
      "label": "DataSource",
      "widget": "text"
    }
  ],
  "actions": [
    {
      "id": "run",
      "label": "GetData",
      "style": "primary"
    },
    {
      "id": "reset",
      "label": "Reset",
      "style": "secondary"
    }
  ]
}