{
  "schemaVersion": "1.0",
  "title": "低吸机会扫描器",
  "description": "Scans for dip-buying opportunities in trending/leader stocks.",
  "sections": [
    {
      "id": "main",
      "label": "扫描配置 (Scan Configuration)",
      "fieldIds": ["universe", "sector", "maxDrawdownPct", "sentimentPhase"]
    },
    {
      "id": "data",
      "label": "数据 (Data)",
      "fieldIds": ["marketData"]
    }
  ],
  "fields": [
    {
      "id": "universe",
      "inputKey": "universe",
      "label": "股票池 (Universe)",
      "widget": "select",
      "options": [
        { "label": "龙头股 (Leaders)", "value": "leaders" },
        { "label": "自选股 (Watchlist)", "value": "watchlist" },
        { "label": "板块 (Sector)", "value": "sector" }
      ],
      "default": "leaders"
    },
    {
      "id": "sector",
      "inputKey": "sector",
      "label": "板块名称 (Sector Name)",
      "widget": "text",
      "placeholder": "e.g. 半导体, AI, 新能源"
    },
    {
      "id": "maxDrawdownPct",
      "inputKey": "maxDrawdownPct",
      "label": "最大回撤% (Max Drawdown %)",
      "widget": "number",
      "default": 10
    },
    {
      "id": "sentimentPhase",
      "inputKey": "sentimentPhase",
      "label": "情绪周期 (Sentiment Phase)",
      "widget": "select",
      "options": [
        { "label": "冰点 (Ice Point)", "value": "冰点" },
        { "label": "回暖 (Warming)", "value": "回暖" },
        { "label": "高潮 (Climax)", "value": "高潮" },
        { "label": "退潮 (Ebb)", "value": "退潮" }
      ]
    },
    {
      "id": "marketData",
      "inputKey": "marketData",
      "label": "市场数据 (Market Data)",
      "widget": "json",
      "placeholder": "Pre-fetched OHLCV data (optional)"
    }
  ],
  "outputs": [
    {
      "id": "output-candidates",
      "outputKey": "candidates",
      "label": "低吸候选 (Dip-Buy Candidates)",
      "widget": "table"
    },
    {
      "id": "output-supportLevels",
      "outputKey": "supportLevels",
      "label": "支撑位 (Support Levels)",
      "widget": "json"
    },
    {
      "id": "output-volumeConfirmation",
      "outputKey": "volumeConfirmation",
      "label": "量能确认 (Volume Confirmation)",
      "widget": "json"
    }
  ],
  "actions": [
    {
      "id": "run",
      "label": "扫描 (Scan)",
      "style": "primary"
    },
    {
      "id": "reset",
      "label": "重置 (Reset)",
      "style": "secondary"
    }
  ]
}
