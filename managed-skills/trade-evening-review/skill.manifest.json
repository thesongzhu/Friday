{
  "schemaVersion": "2.0",
  "id": "trade-evening-review",
  "name": "Evening Review Workflow",
  "description": "Post-market daily review workflow that summarizes P&L, trade journal, dragon-tiger list activity, next-day outlook, and watchlist generation.",
  "version": "1.0.0",
  "kind": "workflow",
  "category": "automation",
  "author": {
    "name": "friday-trade"
  },
  "tags": [
    "trade",
    "workflow",
    "evening",
    "review",
    "a-stock"
  ],
  "runtime": {
    "kind": "shell",
    "entrypoint": "run.sh",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 120000
  },
  "triggers": {
    "schedule": [
      {
        "cron": "0 17 * * 1-5",
        "timezone": "Asia/Shanghai"
      }
    ],
    "intents": [],
    "phrases": [
      "收盘复盘",
      "evening review",
      "post-market review",
      "daily review"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 80,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [
      "node"
    ],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "inputs": [],
  "outputs": [
    {
      "key": "eveningReport",
      "type": "object",
      "description": "Complete evening review report"
    },
    {
      "key": "tomorrowWatchlist",
      "type": "array",
      "description": "Tomorrow Watchlist"
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "shell.execute",
        "resource": "shell",
        "action": "execute",
        "required": true,
        "reason": "Executes workflow orchestration script via run.sh"
      }
    ],
    "promptOn": [
      "shell.execute"
    ]
  },
  "schemas": {
    "input": null,
    "state": null,
    "output": null
  },
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "phone",
      "desktop",
      "rpi",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": []
  }
}