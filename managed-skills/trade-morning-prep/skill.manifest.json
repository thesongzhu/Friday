{
  "schemaVersion": "2.0",
  "id": "trade-morning-prep",
  "name": "早盘准备工作流",
  "description": "每个交易日开盘前自动执行的早盘准备工作流，汇总市场数据、情绪研判、龙头扫描、持仓预警和交易信号。",
  "version": "1.0.0",
  "kind": "workflow",
  "category": "automation",
  "author": {
    "name": "friday-trade"
  },
  "tags": ["trade", "workflow", "morning", "a-stock"],
  "runtime": {
    "kind": "shell",
    "entrypoint": "run.sh",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 120000
  },
  "triggers": {
    "schedule": [
      {
        "cron": "45 8 * * 1-5",
        "timezone": "Asia/Shanghai"
      }
    ],
    "intents": [],
    "phrases": ["早盘准备", "morning prep"],
    "channels": ["*"]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 80,
    "modes": ["intent"]
  },
  "requirements": {
    "bins": ["node"],
    "env": [],
    "config": [],
    "os": ["darwin", "linux", "win32"]
  },
  "inputs": [],
  "outputs": [
    {
      "key": "morningBrief",
      "type": "object",
      "description": "完整的早盘准备报告"
    },
    {
      "key": "signals",
      "type": "array",
      "description": "今日交易信号"
    },
    {
      "key": "exitAlerts",
      "type": "array",
      "description": "现有持仓退出预警"
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "shell.execute",
        "resource": "shell",
        "action": "execute",
        "required": true,
        "reason": "Executes workflow orchestration script via run.sh"
      }
    ],
    "promptOn": ["shell.execute"]
  },
  "schemas": {
    "input": null,
    "state": null,
    "output": null
  },
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": ["phone", "desktop", "rpi", "cloud-vm"],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": []
  }
}
