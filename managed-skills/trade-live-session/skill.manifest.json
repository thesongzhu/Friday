{
  "schemaVersion": "2.0",
  "id": "trade-live-session",
  "name": "盘中监控工作流",
  "description": "交易时段每15分钟执行一次的盘中监控工作流，监控持仓风险和实时交易机会。",
  "version": "1.0.0",
  "kind": "workflow",
  "category": "automation",
  "author": {
    "name": "friday-trade"
  },
  "tags": ["trade", "workflow", "live", "monitor", "a-stock"],
  "runtime": {
    "kind": "shell",
    "entrypoint": "run.sh",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 60000
  },
  "triggers": {
    "schedule": [
      {
        "cron": "*/15 9-14 * * 1-5",
        "timezone": "Asia/Shanghai"
      }
    ],
    "intents": [],
    "phrases": ["盘中监控", "live session"],
    "channels": ["*"]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 90,
    "modes": ["intent"]
  },
  "requirements": {
    "bins": ["node"],
    "env": [],
    "config": [],
    "os": ["darwin", "linux", "win32"]
  },
  "inputs": [
    {
      "key": "urgencyOnly",
      "type": "boolean",
      "description": "仅输出紧急告警，跳过常规监控信息",
      "required": false,
      "default": false
    }
  ],
  "outputs": [
    {
      "key": "alerts",
      "type": "array",
      "description": "可执行的告警列表"
    },
    {
      "key": "marketSnapshot",
      "type": "object",
      "description": "当前市场快照"
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "shell.execute",
        "resource": "shell",
        "action": "execute",
        "required": true,
        "reason": "Executes workflow orchestration script via run.sh"
      }
    ],
    "promptOn": ["shell.execute"]
  },
  "schemas": {
    "input": null,
    "state": null,
    "output": null
  },
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": ["phone", "desktop", "rpi", "cloud-vm"],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": []
  }
}
