{
  "schemaVersion": "2.0",
  "id": "operations-brief-generator",
  "name": "Operations Brief Generator",
  "description": "Creates a concise operations brief from daily metrics with anomalies and root-cause prompts, including a JSON block for Feishu distribution.",
  "version": "1.0.0",
  "kind": "workflow",
  "category": "automation",
  "author": {
    "name": "Your Company"
  },
  "tags": [
    "generated",
    "skill.stabilized"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 30000
  },
  "triggers": {
    "intents": [],
    "phrases": [],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 50,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux",
      "win32"
    ],
    "mcpServers": []
  },
  "inputs": [
    {
      "key": "dailyMetrics",
      "type": "string",
      "required": true,
      "label": "Daily Metrics"
    }
  ],
  "outputs": [
    {
      "key": "operationsBrief",
      "type": "string",
      "description": "Concise operations brief with anomalies and root-cause prompts."
    },
    {
      "key": "feishuJSON",
      "type": "string",
      "description": "JSON block for Feishu distribution."
    }
  ],
  "permissions": {
    "grants": [],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": []
  }
}