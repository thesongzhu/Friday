{
  "schemaVersion": "1.0",
  "title": "Trade Journal",
  "description": "Record and review trade decisions and outcomes",
  "sections": [
    {
      "id": "action",
      "label": "Actions",
      "fieldIds": [
        "action"
      ]
    },
    {
      "id": "trade-info",
      "label": "Trade Info",
      "fieldIds": [
        "symbol",
        "strategy",
        "entryPrice",
        "exitPrice",
        "shares",
        "sentimentPhase",
        "emotionalState"
      ]
    },
    {
      "id": "notes-query",
      "label": "Notes / Query",
      "fieldIds": [
        "notes",
        "query"
      ]
    }
  ],
  "fields": [
    {
      "id": "action",
      "inputKey": "action",
      "label": "Action Type",
      "widget": "select",
      "options": [
        {
          "label": "Record Entry",
          "value": "record_entry"
        },
        {
          "label": "Record Exit",
          "value": "record_exit"
        },
        {
          "label": "Daily Summary",
          "value": "daily_summary"
        },
        {
          "label": "QueryRecord",
          "value": "query"
        }
      ]
    },
    {
      "id": "symbol",
      "inputKey": "symbol",
      "label": "Stock Code",
      "widget": "text",
      "placeholder": "e.g. 000001"
    },
    {
      "id": "strategy",
      "inputKey": "strategy",
      "label": "Trade Strategy",
      "widget": "text",
      "placeholder": "e.g. Board Hit, Dip Buy, Midway"
    },
    {
      "id": "entryPrice",
      "inputKey": "entryPrice",
      "label": "Entry Price",
      "widget": "number",
      "placeholder": "e.g. 15.50"
    },
    {
      "id": "exitPrice",
      "inputKey": "exitPrice",
      "label": "Exit Price",
      "widget": "number",
      "placeholder": "e.g. 16.80"
    },
    {
      "id": "shares",
      "inputKey": "shares",
      "label": "Shares",
      "widget": "number",
      "placeholder": "e.g. 1000"
    },
    {
      "id": "sentimentPhase",
      "inputKey": "sentimentPhase",
      "label": "Sentiment Phase",
      "widget": "text",
      "placeholder": "e.g. Warming, Climax"
    },
    {
      "id": "emotionalState",
      "inputKey": "emotionalState",
      "label": "Emotional State",
      "widget": "select",
      "options": [
        {
          "label": "Calm (calm)",
          "value": "calm"
        },
        {
          "label": "Anxious (anxious)",
          "value": "anxious"
        },
        {
          "label": "Greedy (greedy)",
          "value": "greedy"
        },
        {
          "label": "Fearful (fearful)",
          "value": "fearful"
        },
        {
          "label": "Confident (confident)",
          "value": "confident"
        },
        {
          "label": "ChaseImpulsive (fomo)",
          "value": "fomo"
        }
      ]
    },
    {
      "id": "notes",
      "inputKey": "notes",
      "label": "Notes",
      "widget": "text",
      "placeholder": "Trading Logic、Ideas、Review Notes..."
    },
    {
      "id": "query",
      "inputKey": "query",
      "label": "QueryContent",
      "widget": "text",
      "placeholder": "DailyPhase/Code/Strategy/Keyword Search"
    }
  ],
  "outputs": [
    {
      "id": "output-entry",
      "outputKey": "entry",
      "label": "Journal Entry",
      "widget": "text"
    },
    {
      "id": "output-patterns",
      "outputKey": "patterns",
      "label": "Behavioral Patterns",
      "widget": "text"
    },
    {
      "id": "output-stats",
      "outputKey": "stats",
      "label": "Statistics",
      "widget": "text"
    }
  ],
  "actions": [
    {
      "id": "run",
      "label": "Execute",
      "style": "primary"
    },
    {
      "id": "reset",
      "label": "Reset",
      "style": "secondary"
    }
  ]
}