{
  "schemaVersion": "2.0",
  "id": "trade-performance-analytics",
  "name": "Performance Analytics",
  "description": "Analyzes trading performance over time with win rate, profit factor, drawdown tracking, per-strategy breakdowns, and improvement suggestions.",
  "version": "1.0.0",
  "kind": "system",
  "category": "ai",
  "author": {
    "name": "friday-trade"
  },
  "tags": [
    "trade",
    "performance",
    "analytics",
    "A-stock"
  ],
  "runtime": {
    "kind": "shell",
    "entrypoint": "run.sh",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 30000
  },
  "triggers": {
    "intents": [],
    "phrases": [
      "交易绩效",
      "绩效分析",
      "trade performance",
      "trading analytics",
      "performance analytics",
      "trading stats",
      "how am I doing"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 50,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [
      "node"
    ],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "inputs": [
    {
      "key": "period",
      "type": "string",
      "description": "Analysis period: week, month, quarter, year, or all",
      "required": false,
      "default": "month",
      "enum": [
        "week",
        "month",
        "quarter",
        "year",
        "all"
      ]
    },
    {
      "key": "byStrategy",
      "type": "boolean",
      "description": "Whether to include per-strategy breakdown",
      "required": false,
      "default": true
    },
    {
      "key": "journalData",
      "type": "object",
      "description": "Trade journal data object. If absent, attempts to read from trade-journal skill's data file.",
      "required": false
    },
    {
      "key": "portfolioData",
      "type": "object",
      "description": "Portfolio history data for drawdown calculation",
      "required": false
    }
  ],
  "outputs": [
    {
      "key": "summary",
      "type": "object",
      "description": "Overall performance: win rate, total P&L, average gain/loss, profit factor"
    },
    {
      "key": "byStrategy",
      "type": "array",
      "description": "Per-strategy performance breakdown"
    },
    {
      "key": "bestTrades",
      "type": "array",
      "description": "Top 5 best trades by P&L"
    },
    {
      "key": "worstTrades",
      "type": "array",
      "description": "Top 5 worst trades by P&L"
    },
    {
      "key": "drawdownHistory",
      "type": "array",
      "description": "Drawdown tracking over time"
    },
    {
      "key": "suggestions",
      "type": "array",
      "description": "Improvement suggestions based on detected patterns"
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "shell.execute",
        "resource": "shell",
        "action": "execute",
        "required": true,
        "reason": "Executes performance analytics via Node.js"
      }
    ],
    "promptOn": [
      "shell.execute"
    ]
  },
  "schemas": {
    "input": null,
    "state": null,
    "output": null
  },
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "phone",
      "desktop",
      "rpi",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": []
  }
}