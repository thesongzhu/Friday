      "label": "Analysis Settings",
      "fieldIds": [
        "period",
        "byStrategy"
      ]
    }
  ],
  "fields": [
    {
      "id": "period",
      "inputKey": "period",
      "label": "Analysis Period",
      "widget": "select",
      "options": [
        {
          "label": "This Week",
          "value": "week"
        },
        {
          "label": "This Month",
          "value": "month"
        },
        {
          "label": "This Quarter",
          "value": "quarter"
        },
        {
          "label": "This Year",
          "value": "year"
        },
        {
          "label": "All",
          "value": "all"
        }
      ]
    },
    {
      "id": "byStrategy",
      "inputKey": "byStrategy",
      "label": "Group by Strategy",
      "widget": "toggle"
    }
  ],
  "outputs": [
    {
      "id": "output-summary",
      "outputKey": "summary",
      "label": "Performance Overview",
      "widget": "text"
    },
    {
      "id": "output-byStrategy",
      "outputKey": "byStrategy",
      "label": "Strategy Analysis",
      "widget": "text"
    },
    {
      "id": "output-bestTrades",
