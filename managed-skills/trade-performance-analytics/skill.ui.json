      "label": "Worst Trades Top 5",
      "widget": "text"
    },
    {
      "id": "output-drawdownHistory",
      "outputKey": "drawdownHistory",
      "label": "Drawdown History",
      "widget": "text"
    },
    {
      "id": "output-suggestions",
      "outputKey": "suggestions",
      "label": "Improvement Suggestions",
      "widget": "text"
    }
