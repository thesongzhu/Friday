{
  "schemaVersion": "1.0",
  "title": "Hot Money Tracker",
  "description": "Track hot money trader activity via dragon-tiger list",
  "sections": [
    {
      "id": "main",
      "label": "Parameters",
      "fieldIds": [
        "date",
        "seatNames",
        "symbol"
      ]
    }
  ],
  "fields": [
    {
      "id": "date",
      "inputKey": "date",
      "label": "Query Date",
      "widget": "text",
      "placeholder": "YYYYMMDD，Default: today",
      "required": false
    },
    {
      "id": "seatNames",
      "inputKey": "seatNames",
      "label": "Hot Money Seat Names",
      "widget": "text",
      "placeholder": "e.g.: Dongfang Fortune Lhasa,Huaxin Securities",
      "required": false
    },
    {
      "id": "symbol",
      "inputKey": "symbol",
      "label": "Stock Code",
      "widget": "text",
      "placeholder": "e.g.: 000001",
      "required": false
    }
  ],
  "outputs": [
    {
      "id": "output-topSeats",
      "outputKey": "topSeats",
      "label": "Top Active Seats",
      "widget": "json"
    },
    {
      "id": "output-seatActivity",
      "outputKey": "seatActivity",
      "label": "Seat Activity Details",
      "widget": "json"
    },
    {
      "id": "output-overlaps",
      "outputKey": "overlaps",
      "label": "Multi-Seat Overlap Stocks",
      "widget": "json"
    }
  ],
  "actions": [
    {
      "id": "run",
      "label": "Track Hot Money",
      "style": "primary"
    },
    {
      "id": "reset",
      "label": "Reset",
      "style": "secondary"
    }
  ]
}