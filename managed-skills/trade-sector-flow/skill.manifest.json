{
  "schemaVersion": "2.0",
  "id": "trade-sector-flow",
  "name": "Sector & Capital Flow",
  "description": "Analyzes sector rotation and capital flow data: industry rankings, concept board rankings, individual stock fund flow, and northbound capital flow.",
  "version": "1.0.0",
  "kind": "system",
  "category": "integration",
  "author": {
    "name": "friday-trade"
  },
  "tags": [
    "trade",
    "akshare",
    "fund-flow",
    "sector",
    "a-stock"
  ],
  "runtime": {
    "kind": "shell",
    "entrypoint": "run.sh",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 30000
  },
  "triggers": {
    "intents": [],
    "phrases": [
      "资金流向",
      "板块排名",
      "北向资金",
      "show fund flow",
      "sector flow",
      "capital flow",
      "sector rotation"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 50,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [
      "python3"
    ],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "inputs": [
    {
      "key": "flowType",
      "type": "string",
      "description": "Flow Type：sector_rank=Industry Sector Ranking, concept_rank=Concept Board Ranking, industry_flow=Stock Fund Flow Ranking, northbound=Northbound Capital",
      "required": true,
      "enum": [
        "sector_rank",
        "concept_rank",
        "industry_flow",
        "northbound"
      ]
    },
    {
      "key": "topN",
      "type": "number",
      "description": "Return top NRecord",
      "required": false,
      "default": 10
    }
  ],
  "outputs": [
    {
      "key": "rankings",
      "type": "array",
      "description": "RankingsData"
    },
    {
      "key": "flowData",
      "type": "object",
      "description": "Capital Flow Summary"
    },
    {
      "key": "trendChange",
      "type": "array",
      "description": "TrendChangesData"
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "shell.execute",
        "resource": "shell",
        "action": "execute",
        "required": true,
        "reason": "Executes Python script via run.sh to fetch fund flow data"
      }
    ],
    "promptOn": [
      "shell.execute"
    ]
  },
  "schemas": {
    "input": null,
    "state": null,
    "output": null
  },
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "phone",
      "desktop",
      "rpi",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": []
  }
}