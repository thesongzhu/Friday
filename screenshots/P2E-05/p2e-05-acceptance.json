          ],
          "snippet": "function ActivityTimeline(props){\n          if (Array.isArray(props.lanes)) {\n            var laneContent = props.lanes.length === 0\n              ? '<div class=\"route-detail-empty\">' + escapeHtml(localize(props.locale, \"暂无 agent 活动\", \"No agent activity yet\")) + \"</div>\"\n              : '<div class=\"command-lane-board\" data-command-lane-board=\"true\">' + props.lanes.map(function (lane) {\n                return '<section class=\"command-lane\" data-command-lane=\"' + escapeHtml(lane.id) + '\">' +\n                  '<div class=\"command-lane-header\"><div><strong>' + escapeHtml(lane.title) + '</strong><p style=\"margin:4px 0 0; color:var(--ink-3);\">' + escapeHtml(lane.subtitle || \"\") + '</p></div>' + StatusPill({ tone: lane.tone || \"neutral\", children: escapeHtml(lane.badge || lane.title) }) + '</div>' +\n                  '<div class=\"command-lane-events\">' + lane.events.map(function (event) {\n                    return '<article class=\"command-event-row' + (props.expandedEventId === event.id ? \" is-expanded\" : \"\") + '\" data-command-event=\"' + escapeHtml(event.id) + '\">' +\n                      '<button type=\"button\" class=\"command-event-head\" data-action=\"command-toggle-event\" data-payload=\"' + escapeHtml(event.id) + '\" aria-label=\"' + escapeHtml(localize(props.locale, \"展开事件上下文\", \"Expand event context\")) + '\">' +\n                        '<span style=\"display:flex; align-items:center; gap:10px;\"><span class=\"timeline-dot is-' + escapeHtml(event.tone || \"neutral\") + '\" aria-hidden=\"true\"></span><strong>' + escapeHtml(event.title) + '</strong></span>' +\n                        '<span style=\"display:flex; align-items:center; gap:10px; color:var(--ink-3);\"><span>' + escapeHtml(event.timestampLabel) + '</span><span>' + escapeHtml(props.expandedEventId === event.id ? \"−\" : \"+\") + '</span></span>' +\n                      '</button>' +\n                      '<p style=\"margin:0; color:var(--ink-2);\">' + escapeHtml(event.detail) + '</p>' +\n                      (props.expandedEventId === event.id ? '<div class=\"command-event-context\">' + (event.context || []).map(function (line) {\n                        return '<div>' + escapeHtml(line) + \"</div>\";\n                      }).join(\"\") + \"</div>\" : \"\") +\n                    \"</article>\";\n                  }).join(\"\") + \"</div>\" +\n                \"</section>\";\n              }).join(\"\") + \"</div>\";\n\n            return ShellCard({\n              eyebrow: localize(props.locale, \"活动时间线\", \"Activity Timeline\"),\n              title: escapeHtml(localize(props.locale, \"多代理活动总线\", \"Multi-agent event bus\")),\n              children: laneContent\n            });\n          }\n\n          var events = props.runs\n            .map(function (run) {\n              var status = run.status;\n              return {\n                id: run.id,\n                tone: status === \"completed\" ? \"success\" : status === \"failed\" || status === \"failed_tests\" ? \"warning\" : \"neutral\",\n                title: run.task,\n                detail: describeRunHealth(run, props.locale),\n                timestamp: run.completedAt || run.startedAt\n              };\n            })\n            .sort(function (left, right) {\n              return new Date(right.timestamp).getTime() - new Date(left.timestamp).getTime();\n            })\n            .slice(0, 4);\n\n          var content = events.length === 0\n            ? '<p>' + escapeHtml(localize(props.locale, \"Friday 正在待命。\", \"Friday is standing by.\")) + \"</p>\"\n            : '<div class=\"timeline-list\">' + events.map(function (event) {\n              return '<div class=\"timeline-item\">' +\n                '<span class=\"timeline-dot is-' + escapeHtml(event.tone) + '\" aria-hidden=\"true\"></span>' +\n                '<article class=\"timeline-card\">' +\n                  '<header><p class=\"timeline-card-title\">' + escapeHtml(event.title) + '</p><small>' + escapeHtml(formatRelativeTime(event.timestamp, props.locale, BASE_CLOCK)) + \"</small></header>\" +\n                  '<p>' + escapeHtml(event.detail || localize(props.locale, \"最近一次运行还在处理中。\", \"The latest run is still in progress.\")) + \"</p>\" +\n                \"</article>\" +\n              \"</div>\";\n            }).join(\"\") + \"</div>\";\n\n          return ShellCard({\n            eyebrow: localize(props.locale, \"活动时间线\", \"Activity Timeline\"),\n            title: escapeHtml(localize(props.locale, \"今天的执行脉冲\", \"Today's execution pulse\")),\n            children: content\n          });\n        }"
        }
      }
