{
  "schemaVersion": "1.0",
  "programId": "openclaw-adoption",
  "title": "Friday OpenClaw Adoption Program",
  "repo": {
    "mainBranch": "main",
    "branchPrefix": "codex/openclaw-adoption-phase",
    "mergeStrategy": "squash",
    "requiredChecks": [
      "quality-gate"
    ],
    "failurePolicy": "limited-self-heal-then-pause",
    "maxAutoRepairAttempts": 2
  },
  "guardrails": [
    "Do not create a second registry outside the canonical skills lifecycle and marketplace source backbone.",
    "Do not move Friday away from its operator-first, bounded-autonomy product contract.",
    "Do not expand long-tail connectors before the packaging, trust, and verification layers are closed.",
    "Do not promote a phase unless the branch gates, required PR checks, and post-merge main checks all pass."
  ],
  "phases": [
    {
      "id": "phase0",
      "number": 0,
      "slug": "automation-bootstrap",
      "title": "Automation Bootstrap And Guardrails",
      "summary": "Build the repository-local phase controller, machine-readable manifest, evidence flow, and GitHub promotion loop before product-surface work begins.",
      "dependsOn": [],
      "allowedPaths": [
        "src/automation/openclaw-adoption",
        "src/cli",
        "docs/ops/openclaw-adoption",
        "docs/ops/openclaw-adoption-phase-manifest.json",
        "test/unit/automation/openclaw-adoption",
        "test/unit/cli",
        "package.json"
      ],
      "taskpackPath": "docs/ops/openclaw-adoption/taskpacks/phase-0.json",
      "successCriteria": [
        "The controller can inspect git and GitHub readiness and report blockers without mutating repository state.",
        "The controller can prepare the next phase branch and record implementing state.",
        "The controller can promote a prepared phase through gates, PR creation, merge, and post-merge main verification.",
        "Phase evidence is written to a stable runtime directory for every controller run."
      ],
      "implementation": {
        "mode": "hybrid",
        "workers": [
          {
            "id": "phase0-controller-bootstrap",
            "title": "Bootstrap controller automation state machine and evidence layout",
            "runner": "command",
            "mode": "implementation",
            "steps": [
              {
                "label": "phase0-worker-marker",
                "command": "node",
                "args": [
                  "-e",
                  "console.log('phase0 automation bootstrap worker prepared')"
                ]
              }
            ],
            "allowedPaths": [
              "src/automation/openclaw-adoption",
              "src/cli",
              "docs/ops/openclaw-adoption-phase-manifest.json",
              "test/unit/automation/openclaw-adoption",
              "test/unit/cli",
              "package.json"
            ],
            "successCriteria": [
              "Controller can execute implementation, repair, promotion, stabilize, and closeout flows.",
              "Runtime evidence is emitted under .friday/automation/openclaw-adoption."
            ]
          }
        ],
        "repairPolicy": {
          "enabled": true,
          "maxAttempts": 2,
          "failureCodes": [
            "implementation_failed",
            "branch_gate_failed",
            "required_checks_missing",
            "required_checks_failed",
            "merge_failed",
            "mainline_red",
            "closure_failed"
          ],
          "worker": {
            "id": "phase0-controller-repair",
            "title": "Run targeted repair loop for controller promotion blockers",
            "runner": "command",
            "mode": "repair",
            "steps": [
              {
                "label": "phase0-repair-marker",
                "command": "node",
                "args": [
                  "-e",
                  "console.log('phase0 repair worker prepared')"
                ]
              }
            ],
            "allowedPaths": [
              "src/automation/openclaw-adoption",
              "src/cli",
              "docs/ops/openclaw-adoption-phase-manifest.json",
              "test/unit/automation/openclaw-adoption",
              "test/unit/cli",
              "package.json"
            ]
          },
          "guardrails": [
            "Do not bypass GitHub required checks.",
            "Do not rewrite unrelated repository history."
          ]
        }
      },
      "promotion": {
        "requiredChecks": [
          "quality-gate"
        ],
        "mergeStrategy": "squash",
        "mainlineHealthPolicy": "required-checks-green",
        "stabilizeSuffix": "stabilize"
      },
      "closure": {
        "requiredEvidence": [
          "program.json",
          "phase-0/run.json",
          "phase-0/evidence/latest.json",
          "phase-0/evidence/latest.md"
        ],
        "notes": [
          "Phase 0 must prove the real branch -> PR -> merge -> mainline path."
        ]
      },
      "gates": {
        "fastLocal": [
          {
            "label": "phase0-unit-tests",
            "command": "npx",
            "args": [
              "vitest",
              "run",
              "test/unit/cli/friday-cli.test.ts",
              "test/unit/automation/openclaw-adoption/friday-openclaw-phase-controller.test.ts"
            ]
          }
        ],
        "prePr": [
          {
            "label": "typecheck",
            "command": "npm",
            "args": [
              "run",
              "typecheck"
            ]
          },
          {
            "label": "lint",
            "command": "npm",
            "args": [
              "run",
              "lint"
            ]
          },
          {
            "label": "phase0-unit-tests",
            "command": "npx",
            "args": [
              "vitest",
              "run",
              "test/unit/cli/friday-cli.test.ts",
              "test/unit/automation/openclaw-adoption/friday-openclaw-phase-controller.test.ts"
            ]
          }
        ],
        "postMerge": [
