            "args": [
              "run",
              "build"
            ]
          },
          {
            "label": "doctor",
            "command": "node",
            "args": [
              "dist/cli/friday-cli.js",
              "phases",
              "doctor"
            ]
          }
        ],
        "finalClosure": [
          {
            "label": "phase0-closeout",
            "command": "node",
            "args": [
              "dist/cli/friday-cli.js",
              "phases",
              "closeout",
              "--dry-run"
            ]
          }
        ]
      }
