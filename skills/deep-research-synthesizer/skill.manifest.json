{
  "schemaVersion": "2.0",
  "id": "deep-research-synthesizer",
  "name": "Deep Research Synthesizer",
  "description": "Synthesize insights from data, filter low-value information, identify patterns, and produce actionable summaries.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": { "name": "Friday" },
  "tags": ["starter", "research", "synthesis", "analysis"],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 60000
  },
  "triggers": {
    "intents": ["synthesize_research"],
    "phrases": [
      "synthesize this research",
      "deep research this topic",
      "analyze and summarize these findings",
      "extract insights from this data"
    ],
    "channels": ["*"]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 82,
    "modes": ["intent"]
  },
  "requirements": { "bins": [], "env": [], "config": [], "os": ["darwin", "linux"] },
  "inputs": [
    { "key": "data", "type": "string", "required": true, "label": "Data", "help": "Research data, findings, or notes to synthesize." }
  ],
  "outputs": [
    { "key": "summary", "type": "string", "description": "High-level summary." },
    { "key": "nextStep", "type": "string", "description": "The recommended next action." },
    { "key": "details", "type": "object", "description": "Structured insights and patterns." }
  ],
  "permissions": {
    "grants": [{ "id": "filesystem-read", "resource": "filesystem", "action": "read", "required": false, "reason": "Allow the skill to read lightweight local context when invoked from a workspace." }],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": { "allowedSatelliteTypes": ["desktop", "cloud-vm"], "requiredCapabilities": [] },
  "telemetry": { "events": ["starter_skill_invoked", "starter_skill_suggested"] }
}
