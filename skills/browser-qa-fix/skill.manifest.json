{
  "schemaVersion": "2.0",
  "id": "browser-qa-fix",
  "name": "Browser QA Fix",
  "description": "Apply a bounded low-risk browser QA fix by turning readonly page evidence into a safe HTML metadata patch inside the workspace.",
  "version": "1.0.0",
  "kind": "system",
  "category": "automation",
  "author": {
    "name": "Friday"
  },
  "tags": [
    "starter",
    "starter.qa",
    "safe_mutate",
    "browser",
    "evidence"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 120000
  },
  "triggers": {
    "intents": [
      "browser_qa_fix"
    ],
    "phrases": [
      "apply a browser qa fix",
      "fix the page title",
      "turn this browser qa report into a safe fix"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 84,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux"
    ]
  },
  "inputs": [
    {
      "key": "goal",
      "type": "string",
      "required": false,
      "label": "Fix Goal",
      "help": "Describe the bounded browser QA fix request or include a URL."
    },
    {
      "key": "url",
      "type": "string",
      "required": false,
      "label": "URL",
      "help": "Optional URL to inspect before planning the bounded fix."
    },
    {
      "key": "targetFile",
      "type": "string",
      "required": false,
      "label": "Target File",
      "help": "Optional HTML file to patch. Friday otherwise searches common entrypoints."
    },
    {
      "key": "desiredTitle",
      "type": "string",
      "required": false,
      "label": "Desired Title",
      "help": "Optional explicit title to write."
    },
    {
      "key": "apply",
      "type": "boolean",
      "required": false,
      "label": "Apply Changes",
      "help": "When true, write the bounded HTML title fix."
    }
  ],
  "outputs": [
    {
      "key": "summary",
      "type": "string",
      "description": "Whether Friday prepared or applied the bounded fix."
    },
    {
      "key": "nextStep",
      "type": "string",
      "description": "The next QA-safe verification step."
    },
    {
      "key": "details",
      "type": "object",
      "description": "Target file, inspection evidence, and fix metadata."
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "filesystem-read",
        "resource": "filesystem",
        "action": "read",
        "required": true,
        "reason": "Read the target HTML file and optional evidence before proposing a bounded fix."
      },
      {
        "id": "filesystem-write",
        "resource": "filesystem",
        "action": "write",
        "required": false,
        "reason": "Apply the bounded title fix and persist QA-fix evidence under .friday."
      }
    ],
    "promptOn": [
      "filesystem.write"
    ]
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": [
      "starter_skill_invoked",
      "starter_skill_suggested"
    ]
  }
}
