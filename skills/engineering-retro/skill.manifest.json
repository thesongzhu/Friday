{
  "schemaVersion": "2.0",
  "id": "engineering-retro",
  "name": "Engineering Retro",
  "description": "Summarize recent commits, themes, and Friday evidence into a lightweight engineering retrospective.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": {
    "name": "Friday"
  },
  "tags": [
    "starter",
    "starter.retro",
    "retro",
    "git",
    "evidence"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 120000
  },
  "triggers": {
    "intents": [
      "engineering_retro"
    ],
    "phrases": [
      "run an engineering retro",
      "what did we ship",
      "summarize the recent engineering work"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 82,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [
      "git"
    ],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux"
    ]
  },
  "inputs": [
    {
      "key": "goal",
      "type": "string",
      "required": false,
      "label": "Retro Context",
      "help": "Optional retro framing or theme to keep in mind."
    },
    {
      "key": "sinceDays",
      "type": "number",
      "required": false,
      "label": "Since Days",
      "help": "How many recent days of history to summarize. Defaults to 14."
    }
  ],
  "outputs": [
    {
      "key": "summary",
      "type": "string",
      "description": "High-level retro outcome."
    },
    {
      "key": "nextStep",
      "type": "string",
      "description": "The most useful next operational step."
    },
    {
      "key": "details",
      "type": "object",
      "description": "Themes, risks, wins, and saved evidence."
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "filesystem-read",
        "resource": "filesystem",
        "action": "read",
        "required": false,
        "reason": "Read local evidence context from the workspace."
      },
      {
        "id": "filesystem-write",
        "resource": "filesystem",
        "action": "write",
        "required": false,
        "reason": "Persist the generated retro report under .friday."
      },
      {
        "id": "shell-execute",
        "resource": "shell",
        "action": "execute",
        "required": false,
        "reason": "Run bounded git commands to summarize recent history."
      }
    ],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": [
      "starter_skill_invoked",
      "starter_skill_suggested"
    ]
  }
}
