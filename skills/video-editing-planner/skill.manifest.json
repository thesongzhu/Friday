{
  "schemaVersion": "2.0",
  "id": "video-editing-planner",
  "name": "Video Editing Planner",
  "description": "Suggest editing structure, scene cuts, transitions, and pacing for improved video content quality and engagement.",
  "version": "1.0.0",
  "kind": "system",
  "category": "media",
  "author": { "name": "Friday" },
  "tags": ["starter", "starter.builder", "video", "editing", "pacing"],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 60000
  },
  "triggers": {
    "intents": ["plan_video_editing"],
    "phrases": [
      "plan the editing for this video",
      "suggest cuts and transitions",
      "create an editing plan",
      "optimize this video's pacing"
    ],
    "channels": ["*"]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 50,
    "modes": ["intent"]
  },
  "requirements": { "bins": [], "env": [], "config": [], "os": ["darwin", "linux"] },
  "inputs": [
    { "key": "script", "type": "string", "required": true, "label": "Script", "help": "The video script or content to plan editing for." }
  ],
  "outputs": [
    { "key": "summary", "type": "string", "description": "High-level summary." },
    { "key": "details", "type": "object", "description": "Structured output." }
  ],
  "permissions": {
    "grants": [{ "id": "filesystem-read", "resource": "filesystem", "action": "read", "required": false, "reason": "Allow the skill to read lightweight local context when invoked from a workspace." }],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": { "allowedSatelliteTypes": ["desktop", "cloud-vm"], "requiredCapabilities": [] },
  "telemetry": { "events": ["starter_skill_invoked", "starter_skill_suggested"] }
}
