{
  "schemaVersion": "2.0",
  "id": "excalidraw-diagram-generator",
  "name": "Excalidraw Diagram Generator",
  "description": "Convert textual concepts or workflows into diagram instructions with nodes, connections, and layout guidance.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": { "name": "Friday" },
  "tags": ["starter", "diagram", "excalidraw", "visual"],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 60000
  },
  "triggers": {
    "intents": ["generate_diagram"],
    "phrases": [
      "create a diagram for this",
      "generate an excalidraw diagram",
      "visualize this workflow",
      "map this concept as a diagram"
    ],
    "channels": ["*"]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 50,
    "modes": ["intent"]
  },
  "requirements": { "bins": [], "env": [], "config": [], "os": ["darwin", "linux"] },
  "inputs": [
    { "key": "concept", "type": "string", "required": true, "label": "Concept", "help": "Textual concept or workflow to convert into a diagram." }
  ],
  "outputs": [
    { "key": "summary", "type": "string", "description": "High-level summary." },
    { "key": "details", "type": "object", "description": "Diagram nodes, connections, and layout." }
  ],
  "permissions": {
    "grants": [{ "id": "filesystem-read", "resource": "filesystem", "action": "read", "required": false, "reason": "Allow the skill to read lightweight local context when invoked from a workspace." }],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": { "allowedSatelliteTypes": ["desktop", "cloud-vm"], "requiredCapabilities": [] },
  "telemetry": { "events": ["starter_skill_invoked", "starter_skill_suggested"] }
}
