{
  "schemaVersion": "2.0",
  "id": "summarize-shop-performance",
  "name": "Summarize Shop Performance",
  "description": "Cluster cross-border store-health notes into operational risk buckets and a daily action board.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": {
    "name": "Friday"
  },
  "tags": [
    "starter",
    "starter.cross-border",
    "cross-border",
    "deterministic",
    "store-health"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 60000
  },
  "triggers": {
    "intents": [
      "summarize_shop_performance"
    ],
    "phrases": [
      "summarize today's store performance",
      "cluster store health notes",
      "build the daily store action board"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 90,
    "modes": [
      "intent",
      "workflow"
    ]
  },
  "requirements": {
    "bins": [],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "inputs": [
    {
      "key": "performanceNotes",
      "type": "string",
      "required": true,
      "label": "Performance Notes",
      "help": "Paste daily store-health, shop-performance, refund, or fulfillment notes (one observation per line)."
    }
  ],
  "outputs": [
    {
      "key": "issueClusters",
      "type": "string",
      "description": "Multi-line summary of clustered store-health risks."
    },
    {
      "key": "summary",
      "type": "string",
      "description": "One-line headline for the daily store action board."
    },
    {
      "key": "nextStep",
      "type": "string",
      "description": "Recommended next operator action."
    },
    {
      "key": "details",
      "type": "object",
      "description": "Structured cluster details for UI rendering."
    }
  ],
  "permissions": {
    "grants": [],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": [
      "starter_skill_invoked"
    ]
  }
}
