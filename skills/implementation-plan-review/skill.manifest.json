{
  "schemaVersion": "2.0",
  "id": "implementation-plan-review",
  "name": "Implementation Plan Review",
  "description": "Review an implementation plan for architecture, edge cases, testing, rollback, and observability gaps before coding or shipping.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": {
    "name": "Friday"
  },
  "tags": [
    "starter",
    "starter.builder",
    "planning",
    "review",
    "engineering"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 60000
  },
  "triggers": {
    "intents": [
      "implementation_plan_review"
    ],
    "phrases": [
      "review this implementation plan",
      "review the architecture and test plan",
      "lock the execution plan before coding"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 92,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux"
    ]
  },
  "inputs": [
    {
      "key": "goal",
      "type": "string",
      "required": true,
      "label": "Plan Text",
      "help": "Plan, architecture note, or implementation outline to review."
    }
  ],
  "outputs": [
    {
      "key": "summary",
      "type": "string",
      "description": "High-level plan review summary."
    },
    {
      "key": "nextStep",
      "type": "string",
      "description": "The highest-value next planning action."
    },
    {
      "key": "details",
      "type": "object",
      "description": "Coverage, gaps, and suggested test matrix."
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "filesystem-read",
        "resource": "filesystem",
        "action": "read",
        "required": false,
        "reason": "Allow the skill to read lightweight workspace context when available."
      }
    ],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": [
      "starter_skill_invoked",
      "starter_skill_suggested"
    ]
  }
}
