{
  "schemaVersion": "2.0",
  "id": "translation-assistant",
  "name": "Translation Assistant",
  "description": "Translate text between languages with options for formality level, tone preservation, and domain-specific terminology. Supports LLM-based and optional DeepL API translation.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": { "name": "Friday" },
  "tags": ["starter", "starter.builder", "translation", "language", "i18n", "localization"],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 30000
  },
  "triggers": {
    "intents": ["translate", "translation"],
    "phrases": [
      "translate this to",
      "convert to Chinese",
      "translate to Japanese",
      "what does this mean in English",
      "help me translate",
      "localize this text"
    ],
    "channels": ["*"]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 75,
    "modes": ["intent"]
  },
  "requirements": { "bins": [], "env": [], "config": [], "os": ["darwin", "linux"] },
  "inputs": [
    { "key": "text", "type": "string", "required": true, "label": "Text", "help": "The text to translate." },
    { "key": "targetLang", "type": "string", "required": true, "label": "Target Language", "help": "Target language code or name (e.g. 'zh', 'Japanese', 'es')." },
    { "key": "sourceLang", "type": "string", "required": false, "label": "Source Language", "help": "Source language (auto-detected if omitted)." },
    { "key": "formality", "type": "string", "required": false, "label": "Formality", "help": "Tone: formal, informal, or neutral (default)." },
    { "key": "domain", "type": "string", "required": false, "label": "Domain", "help": "Specialized domain: technical, legal, medical, casual, etc." }
  ],
  "outputs": [
    { "key": "summary", "type": "string", "description": "High-level summary." },
    { "key": "nextStep", "type": "string", "description": "Recommended next action." },
    { "key": "details", "type": "object", "description": "Structured output." }
  ],
  "permissions": {
    "grants": [],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": { "allowedSatelliteTypes": ["desktop", "cloud-vm"], "requiredCapabilities": [] },
  "telemetry": { "events": ["starter_skill_invoked"] }
}
