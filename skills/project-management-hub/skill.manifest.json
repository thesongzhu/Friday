{
  "schemaVersion": "2.0",
  "id": "project-management-hub",
  "name": "Project Management Hub",
  "description": "Unified interface for project management tools (Jira, Linear, Notion, GitHub Issues). Create, list, and update tasks across multiple platforms via MCP integrations.",
  "version": "1.0.0",
  "kind": "system",
  "category": "productivity",
  "author": { "name": "Friday" },
  "tags": ["starter", "starter.builder", "project-management", "jira", "linear", "notion", "tasks"],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 30000
  },
  "triggers": {
    "intents": ["project_management", "task_management"],
    "phrases": [
      "create a task",
      "list my tasks",
      "update ticket status",
      "show project board",
      "what are my open issues",
      "create a Jira ticket",
      "add to Linear backlog"
    ],
    "channels": ["*"]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 80,
    "modes": ["intent"]
  },
  "requirements": { "bins": [], "env": [], "config": [], "os": ["darwin", "linux"] },
  "inputs": [
    { "key": "operation", "type": "string", "required": true, "label": "Operation", "help": "create_task, list_tasks, update_task, or list_platforms" },
    { "key": "title", "type": "string", "required": false, "label": "Title", "help": "Task title (for create/update)." },
    { "key": "description", "type": "string", "required": false, "label": "Description", "help": "Task description." },
    { "key": "status", "type": "string", "required": false, "label": "Status", "help": "Task status (for update)." },
    { "key": "platform", "type": "string", "required": false, "label": "Platform", "help": "Target platform: jira, linear, notion, github." },
    { "key": "taskId", "type": "string", "required": false, "label": "Task ID", "help": "Task identifier (for update)." }
  ],
  "outputs": [
    { "key": "summary", "type": "string", "description": "High-level summary." },
    { "key": "nextStep", "type": "string", "description": "Recommended next action." },
    { "key": "details", "type": "object", "description": "Structured output." }
  ],
  "permissions": {
    "grants": [],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": { "allowedSatelliteTypes": ["desktop", "cloud-vm"], "requiredCapabilities": [] },
  "telemetry": { "events": ["starter_skill_invoked"] }
}
