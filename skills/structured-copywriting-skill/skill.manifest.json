{
  "schemaVersion": "2.0",
  "id": "structured-copywriting-skill",
  "name": "Structured Copywriting Skill",
  "description": "Generate high-impact copy with clear hooks, structured flow, and concise messaging for marketing and social media.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": { "name": "Friday" },
  "tags": ["starter", "copywriting", "marketing", "content"],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 60000
  },
  "triggers": {
    "intents": ["write_copy"],
    "phrases": [
      "write copy for this",
      "create marketing copy",
      "write a social media post with a hook",
      "structured copywriting for this topic"
    ],
    "channels": ["*"]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 50,
    "modes": ["intent"]
  },
  "requirements": { "bins": [], "env": [], "config": [], "os": ["darwin", "linux"] },
  "inputs": [
    { "key": "content", "type": "string", "required": true, "label": "Content", "help": "Topic or raw content to turn into structured copy." },
    { "key": "platform", "type": "string", "required": false, "label": "Platform", "help": "Target platform (e.g. landing-page, email, social). Defaults to general." }
  ],
  "outputs": [
    { "key": "summary", "type": "string", "description": "High-level summary." },
    { "key": "details", "type": "object", "description": "Structured copy with hook, body, and CTA." }
  ],
  "permissions": {
    "grants": [{ "id": "filesystem-read", "resource": "filesystem", "action": "read", "required": false, "reason": "Allow the skill to read lightweight local context when invoked from a workspace." }],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": { "allowedSatelliteTypes": ["desktop", "cloud-vm"], "requiredCapabilities": [] },
  "telemetry": { "events": ["starter_skill_invoked", "starter_skill_suggested"] }
}
