{
  "schemaVersion": "2.0",
  "id": "caption-subtitle-formatter",
  "name": "Caption & Subtitle Formatter",
  "description": "Format captions and subtitles for readability, timing, and accessibility across videos.",
  "version": "1.0.0",
  "kind": "system",
  "category": "media",
  "author": { "name": "Friday" },
  "tags": ["starter", "starter.builder", "captions", "subtitles", "accessibility"],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 60000
  },
  "triggers": {
    "intents": ["format_captions"],
    "phrases": [
      "format these captions",
      "create subtitles for this",
      "optimize these subtitles for readability",
      "format captions with timing"
    ],
    "channels": ["*"]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 76,
    "modes": ["intent"]
  },
  "requirements": { "bins": [], "env": [], "config": [], "os": ["darwin", "linux"] },
  "inputs": [
    { "key": "transcript", "type": "string", "required": true, "label": "Transcript", "help": "Raw transcript text to split into timed caption blocks." }
  ],
  "outputs": [
    { "key": "summary", "type": "string", "description": "High-level summary." },
    { "key": "nextStep", "type": "string", "description": "The recommended next action." },
    { "key": "details", "type": "object", "description": "Structured output." }
  ],
  "permissions": {
    "grants": [{ "id": "filesystem-read", "resource": "filesystem", "action": "read", "required": false, "reason": "Allow the skill to read lightweight local context when invoked from a workspace." }],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": { "allowedSatelliteTypes": ["desktop", "cloud-vm"], "requiredCapabilities": [] },
  "telemetry": { "events": ["starter_skill_invoked", "starter_skill_suggested"] }
}
