{
  "schemaVersion": "2.0",
  "id": "cross-border-weekly-growth-review",
  "name": "Cross-border Weekly Growth Review",
  "description": "Turn the week's operating signals into keep / change / stop guidance for the daily routine.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": {
    "name": "Friday"
  },
  "tags": [
    "starter",
    "starter.cross-border",
    "cross-border",
    "deterministic",
    "operating-profile"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 60000
  },
  "triggers": {
    "intents": [
      "cross_border_weekly_growth_review"
    ],
    "phrases": [
      "review this week's operating signals",
      "tune the weekly operating profile",
      "build the keep change stop board"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 88,
    "modes": [
      "intent",
      "workflow"
    ]
  },
  "requirements": {
    "bins": [],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "inputs": [
    {
      "key": "weeklySignals",
      "type": "string",
      "required": true,
      "label": "Weekly Signals",
      "help": "Paste this week's operating signals — what worked, what didn't, where time was lost (one observation per line)."
    }
  ],
  "outputs": [
    {
      "key": "weeklyReview",
      "type": "string",
      "description": "Multi-line summary of weekly keep / change / stop guidance."
    },
    {
      "key": "summary",
      "type": "string",
      "description": "One-line headline for the weekly tuning board."
    },
    {
      "key": "nextStep",
      "type": "string",
      "description": "Recommended next operator action."
    },
    {
      "key": "details",
      "type": "object",
      "description": "Structured weekly cluster data for UI rendering."
    }
  ],
  "permissions": {
    "grants": [],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": [
      "starter_skill_invoked"
    ]
  }
}
