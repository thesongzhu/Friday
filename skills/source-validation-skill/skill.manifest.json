{
  "schemaVersion": "2.0",
  "id": "source-validation-skill",
  "name": "Source Validation",
  "description": "Validates the credibility of information sources, highlighting reliability, relevance, and potential biases.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": {
    "name": "Friday"
  },
  "tags": [
    "starter",
    "starter.builder",
    "validation",
    "credibility",
    "fact-check"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 60000
  },
  "triggers": {
    "intents": [
      "validate_source"
    ],
    "phrases": [
      "validate these sources",
      "check the credibility of this",
      "is this source reliable",
      "fact check this information"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 82,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux"
    ]
  },
  "inputs": [
    {
      "key": "content",
      "type": "string",
      "required": true,
      "label": "Content",
      "help": "Text or source material to validate for credibility."
    }
  ],
  "outputs": [
    {
      "key": "summary",
      "type": "string",
      "description": "High-level summary."
    },
    {
      "key": "nextStep",
      "type": "string",
      "description": "The recommended next action."
    },
    {
      "key": "details",
      "type": "object",
      "description": "Structured output."
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "filesystem-read",
        "resource": "filesystem",
        "action": "read",
        "required": false,
        "reason": "Allow the skill to read lightweight local context when invoked from a workspace."
      }
    ],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": [
      "starter_skill_invoked",
      "starter_skill_suggested"
    ]
  }
}
