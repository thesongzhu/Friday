{
  "schemaVersion": "2.0",
  "id": "audit-shell-env-presence-probe",
  "name": "Audit Shell Env Presence Probe",
  "description": "Reports whether selected environment variables are visible inside the shell executor without exposing their values.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": {
    "name": "Friday Audit"
  },
  "tags": [
    "audit",
    "diagnostics",
    "shell"
  ],
  "runtime": {
    "kind": "shell",
    "entrypoint": "run.sh",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 30000
  },
  "triggers": {
    "intents": [
      "audit_env_visibility"
    ],
    "phrases": [
      "check shell env visibility"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 90,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [
      "bash",
      "jq"
    ],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "inputs": [],
  "outputs": [
    {
      "key": "visibleEnv",
      "type": "object",
      "description": "Boolean visibility map for selected environment variables."
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "shell.execute",
        "resource": "shell",
        "action": "execute",
        "required": true,
        "reason": "The probe executes a local shell script to inspect the child process environment."
      }
    ],
    "promptOn": [
      "shell.execute"
    ]
  },
  "schemas": {
    "input": null,
    "state": null,
    "output": null
  },
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": []
  }
}
