{
  "schemaVersion": "2.0",
  "id": "devops-assistant",
  "name": "DevOps Assistant",
  "description": "Assist in version control, deployment, and automation tasks, ensuring smooth DevOps operations and workflow efficiency.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": { "name": "Friday" },
  "tags": ["starter", "starter.builder", "devops", "deployment", "ci-cd"],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 60000
  },
  "triggers": {
    "intents": ["devops_assist"],
    "phrases": [
      "help with deployment",
      "devops guidance for this project",
      "optimize my CI/CD pipeline",
      "version control best practices"
    ],
    "channels": ["*"]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 50,
    "modes": ["intent"]
  },
  "requirements": { "bins": [], "env": [], "config": [], "os": ["darwin", "linux"] },
  "inputs": [
    { "key": "task", "type": "string", "required": true, "label": "Task", "help": "Describe the DevOps task or question you need help with." }
  ],
  "outputs": [
    { "key": "summary", "type": "string", "description": "High-level summary." },
    { "key": "details", "type": "object", "description": "Structured output." }
  ],
  "permissions": {
    "grants": [{ "id": "filesystem-read", "resource": "filesystem", "action": "read", "required": false, "reason": "Allow the skill to read lightweight local context when invoked from a workspace." }],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": { "allowedSatelliteTypes": ["desktop", "cloud-vm"], "requiredCapabilities": [] },
  "telemetry": { "events": ["starter_skill_invoked", "starter_skill_suggested"] }
}
