{
  "schemaVersion": "2.0",
  "id": "repo-health-check",
  "name": "Repo Health Check",
  "description": "Review the current repository state, summarize change pressure, and suggest the next useful action.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": {
    "name": "Friday"
  },
  "tags": [
    "starter",
    "starter.cli",
    "starter.devops",
    "cli-backed",
    "skill.stabilized",
    "repo",
    "git",
    "diagnostics"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 120000
  },
  "triggers": {
    "intents": [
      "repo_health_check"
    ],
    "phrases": [
      "review repo health",
      "inspect workspace health",
      "tell me the next best action in this repo"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 90,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [
      "git"
    ],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux"
    ]
  },
  "inputs": [
    {
      "key": "workspaceRoot",
      "type": "string",
      "required": false,
      "label": "Workspace Root",
      "help": "Optional workspace directory to inspect. Defaults to Friday's current working directory."
    }
  ],
  "outputs": [
    {
      "key": "summary",
      "type": "string",
      "description": "High-level repository health summary."
    },
    {
      "key": "nextStep",
      "type": "string",
      "description": "The next suggested action."
    },
    {
      "key": "details",
      "type": "object",
      "description": "Structured repository diagnostics."
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "filesystem-read",
        "resource": "filesystem",
        "action": "read",
        "required": true,
        "reason": "Read repository files, logs, and local metadata to produce diagnostics."
      },
      {
        "id": "shell-execute",
        "resource": "shell",
        "action": "execute",
        "required": false,
        "reason": "Run bounded local inspection commands such as git, lsof, pgrep, and package scripts."
      }
    ],
    "promptOn": [
      "shell.execute"
    ]
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": [
      "starter_skill_invoked",
      "starter_skill_suggested"
    ]
  }
}
