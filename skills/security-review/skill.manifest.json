{
  "schemaVersion": "2.0",
  "id": "security-review",
  "name": "Security Review",
  "description": "Run a bounded static security audit over auth, trust proxy, execution, marketplace, and remote-access surfaces, then persist a local threat-model report.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": {
    "name": "Friday"
  },
  "tags": [
    "starter",
    "starter.security",
    "security",
    "threat-model",
    "evidence"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 120000
  },
  "triggers": {
    "intents": [
      "security_review"
    ],
    "phrases": [
      "run a security review",
      "threat model this repo",
      "audit auth and token safety"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 86,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [
      "rg"
    ],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux"
    ]
  },
  "inputs": [
    {
      "key": "goal",
      "type": "string",
      "required": false,
      "label": "Security Scope",
      "help": "Optional security focus, such as auth, tokens, remote access, or marketplace/plugin paths."
    },
    {
      "key": "workspaceRoot",
      "type": "string",
      "required": false,
      "label": "Workspace Root",
      "help": "Optional workspace directory to inspect."
    }
  ],
  "outputs": [
    {
      "key": "summary",
      "type": "string",
      "description": "High-level security result."
    },
    {
      "key": "nextStep",
      "type": "string",
      "description": "The next security-focused action."
    },
    {
      "key": "details",
      "type": "object",
      "description": "Findings, threat-model focus areas, and evidence paths."
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "filesystem-read",
        "resource": "filesystem",
        "action": "read",
        "required": true,
        "reason": "Read repository files and code surfaces during the audit."
      },
      {
        "id": "filesystem-write",
        "resource": "filesystem",
        "action": "write",
        "required": false,
        "reason": "Persist local security evidence under .friday."
      },
      {
        "id": "shell-execute",
        "resource": "shell",
        "action": "execute",
        "required": false,
        "reason": "Run bounded ripgrep-based code searches across the workspace."
      }
    ],
    "promptOn": [
      "shell.execute"
    ]
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": [
      "starter_skill_invoked",
      "starter_skill_suggested"
    ]
  }
}
