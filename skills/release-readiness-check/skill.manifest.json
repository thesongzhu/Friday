{
  "schemaVersion": "2.0",
  "id": "release-readiness-check",
  "name": "Release Readiness Check",
  "description": "Run the existing repo validation scripts, summarize blockers, and report whether the workspace looks ready to ship.",
  "version": "1.0.0",
  "kind": "system",
  "category": "automation",
  "author": {
    "name": "Friday"
  },
  "tags": [
    "starter",
    "starter.devops",
    "release",
    "build",
    "checks"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 900000
  },
  "triggers": {
    "intents": [
      "release_readiness_check"
    ],
    "phrases": [
      "run release readiness check",
      "check if this repo is ready to ship",
      "run lint test and build"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 95,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [
      "npm"
    ],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux"
    ]
  },
  "inputs": [
    {
      "key": "workspaceRoot",
      "type": "string",
      "required": false,
      "label": "Workspace Root",
      "help": "Optional workspace directory to inspect."
    }
  ],
  "outputs": [
    {
      "key": "readiness",
      "type": "string",
      "description": "Overall readiness verdict."
    },
    {
      "key": "summary",
      "type": "string",
      "description": "Human summary of the check results."
    },
    {
      "key": "checks",
      "type": "array",
      "description": "Per-check execution results."
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "filesystem-read",
        "resource": "filesystem",
        "action": "read",
        "required": true,
        "reason": "Read repository files, logs, and local metadata to produce diagnostics."
      },
      {
        "id": "shell-execute",
        "resource": "shell",
        "action": "execute",
        "required": false,
        "reason": "Run bounded local inspection commands such as git, lsof, pgrep, and package scripts."
      }
    ],
    "promptOn": [
      "shell.execute"
    ]
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": [
      "starter_skill_invoked",
      "starter_skill_suggested"
    ]
  }
}
