{
  "schemaVersion": "2.0",
  "id": "workspace-change-risk-review",
  "name": "Workspace Change Risk Review",
  "description": "Inspect changed files, summarize risk hotspots, and call out missing validation coverage before a release or merge.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": {
    "name": "Friday"
  },
  "tags": [
    "starter",
    "starter.devops",
    "repo",
    "diff",
    "review"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 120000
  },
  "triggers": {
    "intents": [
      "workspace_change_risk_review"
    ],
    "phrases": [
      "review change risk",
      "analyze this diff",
      "what is risky in this workspace change"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 90,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [
      "git"
    ],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux"
    ]
  },
  "inputs": [
    {
      "key": "workspaceRoot",
      "type": "string",
      "required": false,
      "label": "Workspace Root",
      "help": "Optional workspace directory to inspect."
    }
  ],
  "outputs": [
    {
      "key": "riskLevel",
      "type": "string",
      "description": "Overall assessed change risk."
    },
    {
      "key": "summary",
      "type": "string",
      "description": "High-level review summary."
    },
    {
      "key": "risks",
      "type": "array",
      "description": "Specific risk findings."
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "filesystem-read",
        "resource": "filesystem",
        "action": "read",
        "required": true,
        "reason": "Read repository files, logs, and local metadata to produce diagnostics."
      },
      {
        "id": "shell-execute",
        "resource": "shell",
        "action": "execute",
        "required": false,
        "reason": "Run bounded local inspection commands such as git, lsof, pgrep, and package scripts."
      }
    ],
    "promptOn": [
      "shell.execute"
    ]
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": [
      "starter_skill_invoked",
      "starter_skill_suggested"
    ]
  }
}
