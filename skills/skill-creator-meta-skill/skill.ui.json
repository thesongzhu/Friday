{
  "schemaVersion": "1.0",
  "title": "Skill Creator (Meta Skill)",
  "description": "Generate a new AI skill definition from a goal description.",
  "sections": [
    { "id": "inputs", "label": "Inputs", "fieldIds": ["goal", "skillName"] }
  ],
  "fields": [
    {
      "id": "goal",
      "inputKey": "goal",
      "kind": "text",
      "label": "Goal",
      "required": true,
      "help": "Describe what the new skill should do."
    },
    {
      "id": "skillName",
      "inputKey": "skillName",
      "kind": "text",
      "label": "Skill Name",
      "required": false,
      "help": "Optional name for the skill."
    }
  ],
  "outputs": [
    { "id": "summary", "outputKey": "summary", "label": "Summary", "widget": "text" },
    { "id": "details", "outputKey": "details", "label": "Details", "widget": "json" }
  ],
  "actions": [
    { "id": "run", "label": "Create Skill", "style": "primary" }
  ]
}
