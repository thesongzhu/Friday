{
  "schemaVersion": "2.0",
  "id": "skill-creator-meta-skill",
  "name": "Skill Creator (Meta Skill)",
  "description": "Generate new AI skills in structured format, providing name, description, instructions, and a ready-to-use SKILL.md template.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": { "name": "Friday" },
  "tags": ["starter", "starter.builder", "meta", "skill-creation", "generator"],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 60000
  },
  "triggers": {
    "intents": ["create_skill"],
    "phrases": [
      "create a new skill",
      "generate a skill for this",
      "build a custom skill",
      "make a new SKILL.md"
    ],
    "channels": ["*"]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 50,
    "modes": ["intent"]
  },
  "requirements": { "bins": [], "env": [], "config": [], "os": ["darwin", "linux"] },
  "inputs": [
    { "key": "goal", "type": "string", "required": true, "label": "Goal", "help": "Describe what the new skill should do." },
    { "key": "skillName", "type": "string", "required": false, "label": "Skill Name", "help": "Optional: provide a name for the skill. One will be generated if omitted." }
  ],
  "outputs": [
    { "key": "summary", "type": "string", "description": "High-level summary." },
    { "key": "details", "type": "object", "description": "Structured output." }
  ],
  "permissions": {
    "grants": [{ "id": "filesystem-read", "resource": "filesystem", "action": "read", "required": false, "reason": "Allow the skill to read lightweight local context when invoked from a workspace." }],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": { "allowedSatelliteTypes": ["desktop", "cloud-vm"], "requiredCapabilities": [] },
  "telemetry": { "events": ["starter_skill_invoked", "starter_skill_suggested"] }
}
