{
  "schemaVersion": "2.0",
  "id": "cross-border-listing-image-layout-audit",
  "name": "Cross-border Listing Image Layout Audit",
  "description": "Audit listing image and layout notes — first-impression hero, info hierarchy, lifestyle vs studio, copy density — into a follow-up checklist.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": {
    "name": "Friday"
  },
  "tags": [
    "starter",
    "starter.cross-border",
    "cross-border",
    "deterministic",
    "listing-audit"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 60000
  },
  "triggers": {
    "intents": [
      "cross_border_listing_image_layout_audit"
    ],
    "phrases": [
      "audit listing image layout",
      "review listing main image and detail page",
      "build the listing follow-up checklist"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 88,
    "modes": [
      "intent",
      "workflow"
    ]
  },
  "requirements": {
    "bins": [],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "inputs": [
    {
      "key": "listingNotes",
      "type": "string",
      "required": true,
      "label": "Listing Notes",
      "help": "Paste listing image / detail-page / layout observations or a weekly review summary; one observation per line."
    }
  ],
  "outputs": [
    {
      "key": "listingAudit",
      "type": "string",
      "description": "Multi-line summary of listing audit findings and follow-up checklist."
    },
    {
      "key": "summary",
      "type": "string",
      "description": "One-line headline for the listing audit."
    },
    {
      "key": "nextStep",
      "type": "string",
      "description": "Recommended next operator action."
    },
    {
      "key": "details",
      "type": "object",
      "description": "Structured listing audit data for UI rendering."
    }
  ],
  "permissions": {
    "grants": [],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": [
      "starter_skill_invoked"
    ]
  }
}
