{
  "schemaVersion": "2.0",
  "id": "system-health-snapshot",
  "name": "System Health Snapshot",
  "description": "Read Friday's current runtime snapshot and summarize system, browser, companion, and approval health.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": {
    "name": "Friday"
  },
  "tags": [
    "starter",
    "starter.diagnosis",
    "system",
    "health",
    "runtime"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 30000
  },
  "triggers": {
    "intents": [
      "system_health_snapshot"
    ],
    "phrases": [
      "show me system health",
      "take a system snapshot",
      "what is wrong with friday runtime"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 92,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux"
    ]
  },
  "inputs": [],
  "outputs": [
    {
      "key": "summary",
      "type": "string",
      "description": "High-level runtime health summary."
    },
    {
      "key": "nextStep",
      "type": "string",
      "description": "The next recommended diagnostic action."
    },
    {
      "key": "details",
      "type": "object",
      "description": "Structured runtime snapshot details."
    }
  ],
  "permissions": {
    "grants": [],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": [
      "starter_skill_invoked",
      "starter_skill_suggested"
    ]
  }
}
