{
  "schemaVersion": "2.0",
  "id": "onchain-transaction-analyzer",
  "name": "Onchain Transaction Analyzer",
  "description": "Analyze blockchain transactions by tracing wallets, contracts, and token movements with plain language explanations.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": { "name": "Friday" },
  "tags": ["starter", "blockchain", "onchain", "transaction"],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 60000
  },
  "triggers": {
    "intents": ["analyze_onchain"],
    "phrases": [
      "analyze this transaction",
      "trace this wallet",
      "explain this onchain activity",
      "decode this blockchain transaction"
    ],
    "channels": ["*"]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 82,
    "modes": ["intent"]
  },
  "requirements": { "bins": [], "env": [], "config": [], "os": ["darwin", "linux"] },
  "inputs": [
    { "key": "transaction", "type": "string", "required": true, "label": "Transaction", "help": "Transaction hash, wallet address, or description of onchain activity." },
    { "key": "chain", "type": "string", "required": false, "label": "Chain", "help": "Blockchain network (e.g. ethereum, polygon, arbitrum). Defaults to ethereum." }
  ],
  "outputs": [
    { "key": "summary", "type": "string", "description": "High-level summary." },
    { "key": "nextStep", "type": "string", "description": "The recommended next action." },
    { "key": "details", "type": "object", "description": "Structured transaction analysis." }
  ],
  "permissions": {
    "grants": [{ "id": "filesystem-read", "resource": "filesystem", "action": "read", "required": false, "reason": "Allow the skill to read lightweight local context when invoked from a workspace." }],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": { "allowedSatelliteTypes": ["desktop", "cloud-vm"], "requiredCapabilities": [] },
  "telemetry": { "events": ["starter_skill_invoked", "starter_skill_suggested"] }
}
