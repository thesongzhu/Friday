{
  "schemaVersion": "2.0",
  "id": "cross-border-top-category-watch",
  "name": "Cross-border Top Category Watch",
  "description": "Track Top 10 category movement, seller shifts, pricing changes, and creative updates from category watch notes.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": {
    "name": "Friday"
  },
  "tags": [
    "starter",
    "starter.cross-border",
    "cross-border",
    "deterministic",
    "category-watch"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 60000
  },
  "triggers": {
    "intents": [
      "cross_border_top_category_watch"
    ],
    "phrases": [
      "watch the top 10 category",
      "summarize category top movers",
      "build the daily category watch board"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 88,
    "modes": [
      "intent",
      "workflow"
    ]
  },
  "requirements": {
    "bins": [],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "inputs": [
    {
      "key": "categoryWatchNotes",
      "type": "string",
      "required": true,
      "label": "Category Watch Notes",
      "help": "Paste daily category Top 10 movement notes, seller changes, price drops, or creative updates (one observation per line)."
    }
  ],
  "outputs": [
    {
      "key": "watchBoard",
      "type": "string",
      "description": "Multi-line summary of category Top 10 watch findings."
    },
    {
      "key": "summary",
      "type": "string",
      "description": "One-line headline for the category watch board."
    },
    {
      "key": "nextStep",
      "type": "string",
      "description": "Recommended next operator action."
    },
    {
      "key": "details",
      "type": "object",
      "description": "Structured cluster details for UI rendering."
    }
  ],
  "permissions": {
    "grants": [],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": [
      "starter_skill_invoked"
    ]
  }
}
