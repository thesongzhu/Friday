{
  "schemaVersion": "2.0",
  "id": "content-repurposing-engine",
  "name": "Content Repurposing Engine",
  "description": "Convert long-form content into multiple platform-specific formats while preserving the core message.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": { "name": "Friday" },
  "tags": ["starter", "content", "repurpose", "social-media"],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 60000
  },
  "triggers": {
    "intents": ["repurpose_content"],
    "phrases": [
      "repurpose this content",
      "turn this article into a twitter thread",
      "convert this blog post for social media",
      "adapt this for multiple platforms"
    ],
    "channels": ["*"]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 50,
    "modes": ["intent"]
  },
  "requirements": { "bins": [], "env": [], "config": [], "os": ["darwin", "linux"] },
  "inputs": [
    { "key": "content", "type": "string", "required": true, "label": "Content", "help": "Long-form content to repurpose." },
    { "key": "targetPlatform", "type": "string", "required": false, "label": "Target Platform", "help": "Platform to adapt for (e.g. twitter, linkedin, blog, email)." }
  ],
  "outputs": [
    { "key": "summary", "type": "string", "description": "High-level summary." },
    { "key": "details", "type": "object", "description": "Structured repurposed content." }
  ],
  "permissions": {
    "grants": [{ "id": "filesystem-read", "resource": "filesystem", "action": "read", "required": false, "reason": "Allow the skill to read lightweight local context when invoked from a workspace." }],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": { "allowedSatelliteTypes": ["desktop", "cloud-vm"], "requiredCapabilities": [] },
  "telemetry": { "events": ["starter_skill_invoked", "starter_skill_suggested"] }
}
