{
  "schemaVersion": "2.0",
  "id": "idea-clarifier",
  "name": "Idea Clarifier",
  "description": "Clarify a vague product or implementation idea into a bounded objective, key questions, and the next concrete planning step.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": {
    "name": "Friday"
  },
  "tags": [
    "starter",
    "starter.builder",
    "planning",
    "clarification",
    "product"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 60000
  },
  "triggers": {
    "intents": [
      "clarify_idea"
    ],
    "phrases": [
      "clarify this idea",
      "help me scope this request",
      "turn this vague idea into a concrete starting point"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 92,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux"
    ]
  },
  "inputs": [
    {
      "key": "goal",
      "type": "string",
      "required": true,
      "label": "Goal",
      "help": "Plain-language request or idea to clarify."
    }
  ],
  "outputs": [
    {
      "key": "summary",
      "type": "string",
      "description": "High-level clarification summary."
    },
    {
      "key": "nextStep",
      "type": "string",
      "description": "The most useful next clarifying action."
    },
    {
      "key": "details",
      "type": "object",
      "description": "Structured questions, scope hints, and recommended next skill."
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "filesystem-read",
        "resource": "filesystem",
        "action": "read",
        "required": false,
        "reason": "Allow the skill to read lightweight local context when invoked from a workspace."
      }
    ],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": [
      "starter_skill_invoked",
      "starter_skill_suggested"
    ]
  }
}
