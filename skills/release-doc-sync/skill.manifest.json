{
  "schemaVersion": "2.0",
  "id": "release-doc-sync",
  "name": "Release Doc Sync",
  "description": "Prepare or apply bounded README, CHANGELOG, and architecture doc updates for the current workspace changes.",
  "version": "1.0.0",
  "kind": "system",
  "category": "automation",
  "author": {
    "name": "Friday"
  },
  "tags": [
    "starter",
    "starter.release",
    "docs",
    "release",
    "safe_mutate"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 120000
  },
  "triggers": {
    "intents": [
      "release_doc_sync"
    ],
    "phrases": [
      "sync release docs",
      "update readme and changelog for this release",
      "document what shipped"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 91,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [
      "git"
    ],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux"
    ]
  },
  "inputs": [
    {
      "key": "goal",
      "type": "string",
      "required": false,
      "label": "Release Summary",
      "help": "Optional summary of what changed. Friday uses it to sharpen the generated highlights."
    },
    {
      "key": "apply",
      "type": "boolean",
      "required": false,
      "label": "Apply Changes",
      "help": "When true, write the managed doc updates to disk. Otherwise Friday returns a preview only."
    },
    {
      "key": "workspaceRoot",
      "type": "string",
      "required": false,
      "label": "Workspace Root",
      "help": "Optional workspace directory to inspect."
    }
  ],
  "outputs": [
    {
      "key": "summary",
      "type": "string",
      "description": "Whether doc updates were prepared or applied."
    },
    {
      "key": "nextStep",
      "type": "string",
      "description": "The next release-safe action."
    },
    {
      "key": "details",
      "type": "object",
      "description": "Changed paths, generated highlights, and updated files."
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "filesystem-read",
        "resource": "filesystem",
        "action": "read",
        "required": true,
        "reason": "Read repository docs and metadata to prepare release updates."
      },
      {
        "id": "filesystem-write",
        "resource": "filesystem",
        "action": "write",
        "required": false,
        "reason": "Write bounded managed-block updates into release-facing docs when apply=true."
      },
      {
        "id": "shell-execute",
        "resource": "shell",
        "action": "execute",
        "required": false,
        "reason": "Run bounded git inspection commands to summarize the current release surface."
      }
    ],
    "promptOn": [
      "filesystem.write",
      "shell.execute"
    ]
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": [
      "starter_skill_invoked",
      "starter_skill_suggested"
    ]
  }
}
