{
  "schemaVersion": "2.0",
  "id": "design-plan-review",
  "name": "Design Plan Review",
  "description": "Review a UI or UX plan for hierarchy, states, accessibility, and interaction clarity before implementation.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": {
    "name": "Friday"
  },
  "tags": [
    "starter",
    "starter.builder",
    "design",
    "review",
    "ui"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 120000
  },
  "triggers": {
    "intents": [
      "design_plan_review"
    ],
    "phrases": [
      "review this design plan",
      "design critique this plan",
      "ui review before implementation"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 83,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux"
    ]
  },
  "inputs": [
    {
      "key": "goal",
      "type": "string",
      "required": true,
      "label": "Design Plan",
      "help": "Describe the page, flow, or design requirements to review."
    }
  ],
  "outputs": [
    {
      "key": "summary",
      "type": "string",
      "description": "High-level design plan review result."
    },
    {
      "key": "nextStep",
      "type": "string",
      "description": "The next design-safe action."
    },
    {
      "key": "details",
      "type": "object",
      "description": "Scores and recommendations."
    }
  ],
  "permissions": {
    "grants": [],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": [
      "starter_skill_invoked",
      "starter_skill_suggested"
    ]
  }
}
