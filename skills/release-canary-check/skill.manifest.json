{
  "schemaVersion": "2.0",
  "id": "release-canary-check",
  "name": "Release Canary Check",
  "description": "Inspect one or more pages with Friday's readonly browser runtime, persist local canary evidence, and compare against the most recent run.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": {
    "name": "Friday"
  },
  "tags": [
    "starter",
    "starter.release",
    "starter.qa",
    "canary",
    "evidence"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 120000
  },
  "triggers": {
    "intents": [
      "release_canary_check"
    ],
    "phrases": [
      "run a canary check",
      "monitor this deploy",
      "check post deploy health"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 87,
    "modes": [
      "intent"
    ]
  },
  "requirements": {
    "bins": [],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux"
    ]
  },
  "inputs": [
    {
      "key": "goal",
      "type": "string",
      "required": false,
      "label": "Canary Goal",
      "help": "Describe the deploy check or include one or more URLs."
    },
    {
      "key": "url",
      "type": "string",
      "required": false,
      "label": "URL",
      "help": "Optional single URL to inspect."
    },
    {
      "key": "urls",
      "type": "array",
      "required": false,
      "label": "URLs",
      "help": "Optional list of URLs to inspect in one run."
    },
    {
      "key": "expectedText",
      "type": "string",
      "required": false,
      "label": "Expected Text",
      "help": "Text that should appear in the rendered accessibility snapshot."
    }
  ],
  "outputs": [
    {
      "key": "summary",
      "type": "string",
      "description": "High-level canary result."
    },
    {
      "key": "nextStep",
      "type": "string",
      "description": "The most useful next canary action."
    },
    {
      "key": "details",
      "type": "object",
      "description": "Per-page findings, evidence, and run metadata."
    }
  ],
  "permissions": {
    "grants": [
      {
        "id": "filesystem-read",
        "resource": "filesystem",
        "action": "read",
        "required": false,
        "reason": "Read local workspace context for evidence placement."
      },
      {
        "id": "filesystem-write",
        "resource": "filesystem",
        "action": "write",
        "required": false,
        "reason": "Persist canary evidence under .friday."
      }
    ],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": [
      "starter_skill_invoked",
      "starter_skill_suggested"
    ]
  }
}
