{
  "schemaVersion": "2.0",
  "id": "cross-border-price-match-review",
  "name": "Cross-border Price Match Review",
  "description": "Compare price band, coupons, shipping promise, and bundle framing to recommend match, hold, or human review.",
  "version": "1.0.0",
  "kind": "system",
  "category": "utility",
  "author": {
    "name": "Friday"
  },
  "tags": [
    "starter",
    "starter.cross-border",
    "cross-border",
    "deterministic",
    "pricing"
  ],
  "runtime": {
    "kind": "node",
    "entrypoint": "index.mjs",
    "minHubVersion": "1.0.0",
    "apiVersion": "1",
    "timeoutMsDefault": 60000
  },
  "triggers": {
    "intents": [
      "cross_border_price_match_review"
    ],
    "phrases": [
      "review competitor price gap",
      "should we match this price",
      "summarize price gap signals"
    ],
    "channels": [
      "*"
    ]
  },
  "invocation": {
    "userInvocable": true,
    "modelInvocable": true,
    "priority": 88,
    "modes": [
      "intent",
      "workflow"
    ]
  },
  "requirements": {
    "bins": [],
    "env": [],
    "config": [],
    "os": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "inputs": [
    {
      "key": "priceSignals",
      "type": "string",
      "required": true,
      "label": "Price Signals",
      "help": "Paste competitor price, coupon, shipping, and bundle observations (one observation per line)."
    }
  ],
  "outputs": [
    {
      "key": "priceReview",
      "type": "string",
      "description": "Multi-line summary of price-gap findings and recommended action."
    },
    {
      "key": "summary",
      "type": "string",
      "description": "One-line headline for the price-gap review."
    },
    {
      "key": "nextStep",
      "type": "string",
      "description": "Recommended next operator action."
    },
    {
      "key": "details",
      "type": "object",
      "description": "Structured cluster details for UI rendering."
    }
  ],
  "permissions": {
    "grants": [],
    "promptOn": []
  },
  "schemas": null,
  "flow": null,
  "executionTargets": {
    "allowedSatelliteTypes": [
      "desktop",
      "cloud-vm"
    ],
    "requiredCapabilities": []
  },
  "telemetry": {
    "events": [
      "starter_skill_invoked"
    ]
  }
}
